  }

  .unit-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-muted);
    margin: 0;
  }

  /* Product Pills (Maize uses ink text on maize yellow!) */
  .product-pill {
    display: inline-flex;
