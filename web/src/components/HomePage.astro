---
import {
  formatComputedStoryProse,
  formatDecimal,
  formatInt,
  formatModelName,
  formatPct,
  formatSignedPct,
  formatYearMonth,
  formatZoneName,
  getDictionary,
  getLocalizedRoutes,
  type Locale,
  type ProductSlug,
} from '../i18n';
import {
  buildBeninDotMapGeometry,
  buildHeroChartGeometry,
  buildSparklineGeometry,
} from '../lib/charts';
import { getValidatedHomeData, type HistoryPoint, type HomeProductData } from '../lib/data';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const routes = getLocalizedRoutes(locale, import.meta.env.BASE_URL);
const homeData = getValidatedHomeData();

const productOrder: ProductSlug[] = ['maize_white', 'tomatoes', 'yam_white'];

/**
 * Guarantee full 93-month calendar grid (`2019-01-15..2026-09-15`) with explicit `is_observed: false, price: null`
 * on unobserved months so `d3.line().defined()` always breaks across missing months (`2019-05..2019-12`, `2022-03`, etc.).
 */
function ensureFull93MonthHistory(rawHistory: HistoryPoint[]): HistoryPoint[] {
  const byDate = new Map<string, HistoryPoint>();
  for (const pt of rawHistory) {
    if (pt.date >= '2019-01-15' && pt.is_observed !== false && typeof pt.price === 'number') {
      byDate.set(pt.date, pt);
    }
  }
  const fullGrid: HistoryPoint[] = [];
  for (let yr = 2019; yr <= 2026; yr++) {
    const maxMo = yr === 2026 ? 9 : 12;
    for (let mo = 1; mo <= maxMo; mo++) {
      const mStr = String(mo).padStart(2, '0');
      const dStr = `${yr}-${mStr}-15`;
      const ymStr = `${yr}-${mStr}`;
      const existing = byDate.get(dStr);
      if (existing) {
        fullGrid.push({
          date: dStr,
          year_month: ymStr,
          price: existing.price,
          is_observed: true,
          is_outlier: Boolean(existing.is_outlier),
        });
      } else {
        fullGrid.push({
          date: dStr,
          year_month: ymStr,
          price: null,
          is_observed: false,
          is_outlier: false,
        });
      }
    }
  }
  return fullGrid;
}

/**
 * Build the one plain headline sentence for each "Méthode retenue" block
 * and the detailed technical tooltip string.
 */
function getReliabilityHeadlineAndTooltip(
  prod: HomeProductData,
  hKey: 'h1' | 'h2' | 'h3'
): { headline: string; detailedTooltip: string } {
  const relObj = prod.reliability_by_horizon[hKey];
  const accObj = prod.backtest_accuracy.by_horizon_test[hKey];
  const champLabel = formatModelName(accObj.model_used, dict);
  const baseLabel = formatModelName(
    relObj.best_validation_baseline || accObj.best_baseline_val,
    dict
  );
  const maeStr = formatDecimal(accObj.mae, locale, 1);
  const mapeStr = formatDecimal(accObj.mape, locale, 1);
  const cov80Str = formatDecimal(relObj.holdout_coverage_80_pct ?? accObj.coverage_80, locale, 1);
  const skillStr = formatSignedPct(
    relObj.skill_vs_best_baseline_test_pct ?? accObj.skill_vs_best_baseline_pct,
    locale,
    1
  );

  const headline = dict.home.hero.headlineReliabilityTemplate
    .replace('{n}', String(prod.tier1_markets_count))
    .replace('{mape}', mapeStr)
    .replace('{cov80}', cov80Str);

  if (locale === 'fr') {
    const detailedTooltip = `Méthode retenue : ${champLabel}. Sur l'ensemble des ${prod.tier1_markets_count} marchés suivis (12 mois de test, oct. 2025 – sept. 2026), à 3 mois : erreur moyenne de ${maeStr} XOF/kg (${mapeStr} %) ; écart face à la méthode simple « ${baseLabel} » : ${skillStr} ; la fourchette à 80 % a contenu ${cov80Str} % des prix observés.`;
    return { headline, detailedTooltip };
  }

  const detailedTooltip = `Selected method: ${champLabel}. Across all ${prod.tier1_markets_count} well-tracked markets (12 test months, Oct 2025 – Sep 2026), at 3 months: average error of ${maeStr} XOF/kg (${mapeStr}%); gain vs simple method "${baseLabel}": ${skillStr}; the 80% interval contained ${cov80Str}% of observed prices.`;
  return { headline, detailedTooltip };
}

// Pre-compute D3 SVG geometries for all 3 products at build time
const productViews = productOrder.map((slug) => {
  const prod = homeData.products[slug];
  const fullHistory93 = ensureFull93MonthHistory(prod.dantokpa.history);
  const heroGeom = buildHeroChartGeometry(fullHistory93, prod.dantokpa.forecasts, 820, 336);
  const sparkGeom = buildSparklineGeometry(prod.latest_national_stats.sparkline_36m, 300, 68);
  const mapGeom = buildBeninDotMapGeometry(
    prod.tier1_markets_map,
    slug,
    dict.mapLatBands,
    430,
    520
  );
  const fcH1 = prod.dantokpa.forecasts.find((f) => f.horizon_months === 1)!;
  const fcH2 = prod.dantokpa.forecasts.find((f) => f.horizon_months === 2)!;
  const fcH3 = prod.dantokpa.forecasts.find((f) => f.horizon_months === 3)!;
  const relH1 = prod.reliability_by_horizon.h1;
  const relH2 = prod.reliability_by_horizon.h2;
  const relH3 = prod.reliability_by_horizon.h3;
  const testH3 = prod.backtest_accuracy.by_horizon_test.h3;

  const peakMonthName =
    dict.months[String(prod.seasonality.peak_month_num) as keyof typeof dict.months];
  const troughMonthName =
    dict.months[String(prod.seasonality.trough_month_num) as keyof typeof dict.months];
  const peakToTroughRatio =
    prod.seasonality.peak_to_trough_ratio ??
    Math.round((prod.seasonality.peak_index / prod.seasonality.trough_index) * 100) / 100;

  const computedStoryProse = formatComputedStoryProse(
    prod.tier1_markets_count,
    troughMonthName,
    peakMonthName,
    formatDecimal(peakToTroughRatio, locale, 2),
    dict
  );

  // Last 12 calendar months + 3 forecast months for the accessible Dantokpa table drawer
  const recentHistory12 = fullHistory93.slice(-12);
  const { headline: headlineH3, detailedTooltip: detailedTooltipH3 } =
    getReliabilityHeadlineAndTooltip(prod, 'h3');

  return {
    slug,
    prod,
    heroGeom,
    sparkGeom,
    mapGeom,
    fcH1,
    fcH2,
    fcH3,
    relH1,
    relH2,
    relH3,
    testH3,
    peakMonthName,
    troughMonthName,
    peakToTroughRatio,
    computedStoryProse,
    recentHistory12,
    headlineH3,
    detailedTooltipH3,
  };
});

// Serialize compact morph geometry for the 600ms Hero product switch animation
const heroMorphMap = Object.fromEntries(
  productViews.map(({ slug, heroGeom }) => [
    slug,
    {
      x93: heroGeom.morphData.x93,
      y93: heroGeom.morphData.y93,
      def93: heroGeom.morphData.def93,
      fcBridge: heroGeom.morphData.fcBridge,
      historyPath: heroGeom.historyPath,
      forecastPath: heroGeom.forecastPath,
      band80Path: heroGeom.band80Path,
      band90Path: heroGeom.band90Path,
      peak: { x: heroGeom.peakPoint.x, y: heroGeom.peakPoint.y },
      lastObs: { x: heroGeom.lastObsPoint.x, y: heroGeom.lastObsPoint.y },
      fcDots: heroGeom.forecastPoints.map((fp) => ({ x: fp.x, y: fp.y })),
    },
  ])
);
---

<!-- =======================================================================
     1. HERO: Editorial Thesis (4 cols) + Unboxed Large Dantokpa Chart (8 cols)
     ======================================================================= -->
<section
  class="section-block hero-section"
  data-active-product="maize_white"
  data-hero-morph={JSON.stringify(heroMorphMap)}
  id="hero-root"
>
  <div class="container">
    <div class="grid-12 hero-grid">
      <!-- Left Column (Cols 1-4 on Desktop): Headline, Subtitle, Product Chips, CTAs -->
      <div class="hero-copy-col">
        <p class="hero-kicker">{dict.home.hero.kicker}</p>
        <h1 class="hero-title">{dict.home.hero.title}</h1>
        <p class="hero-subtitle">{dict.home.hero.subtitle}</p>

        <div class="hero-selector-block">
          <span class="selector-label" id="hero-product-selector-label">
            {dict.home.hero.productSelectorLabel}
          </span>
          <div class="chip-group" role="group" aria-labelledby="hero-product-selector-label">
            {
              productOrder.map((slug, idx) => (
                <button
                  type="button"
                  class="product-chip"
                  data-product={slug}
                  data-role="product-switch"
                  aria-pressed={idx === 0 ? 'true' : 'false'}
                >
                  <span class="chip-swatch" aria-hidden="true" />
                  <span>{dict.products[slug].chip}</span>
                </button>
              ))
            }
          </div>
        </div>

        <div class="btn-row">
          <a href={routes.explorer} class="btn btn-primary">
            {dict.home.hero.ctaExplorer}
          </a>
          <a href={routes.forecast} class="btn btn-secondary">
            {dict.home.hero.ctaForecast}
          </a>
        </div>
      </div>

      <!-- Right Column (Cols 5-12 on Desktop): Unboxed Large Dantokpa Chart Directly on Sand -->
      <div class="hero-chart-col">
        {
          productViews.map((view, idx) => {
            const {
              slug,
              prod,
              heroGeom,
              fcH3,
              relH3,
              recentHistory12,
              headlineH3,
              detailedTooltipH3,
            } = view;
            const isDefault = idx === 0;
            const relLabel =
              dict.reliability[relH3.status as keyof typeof dict.reliability] ?? relH3.status;
            const modelH3Plain = formatModelName(fcH3.model_used, dict);
            const peakDateShort = formatYearMonth(heroGeom.peakPoint.date, dict);
            const lastObsDateShort = formatYearMonth(heroGeom.lastObsPoint.date, dict);
            const fc3DateShort = formatYearMonth(fcH3.target_date, dict);

            return (
              <article
                class="hero-chart-panel"
                data-product-panel={slug}
                hidden={!isDefault}
                aria-label={`${dict.home.hero.chartTitlePrefix} ${dict.products[slug].full}`}
              >
                <header class="chart-card-header">
                  <div>
                    <div class="chart-title-row">
                      <span class={`product-pill pill-${slug}`}>{dict.products[slug].chip}</span>
                      <h2 class="chart-card-title">
                        {dict.home.hero.chartTitlePrefix} {dict.products[slug].full}
                      </h2>
                    </div>
                    <p class="chart-card-subtitle">{dict.home.hero.chartSubtitle}</p>
                  </div>
                  <div class="chart-header-meta">
                    <span class="unit-badge tabular-nums">{dict.units.nominalRetailNotice}</span>
                  </div>
                </header>

                <!-- Large Unboxed D3 SVG Chart (viewBox="0 0 820 336") Directly on Sand -->
                <div class="svg-chart-wrap">
                  <svg
                    viewBox={`0 0 ${heroGeom.width} ${heroGeom.height}`}
                    class="hero-svg"
                    role="img"
                    aria-label={`${dict.home.hero.chartTitlePrefix} ${dict.products[slug].full} (2019–2026)`}
                  >
                    <title>
                      {dict.home.hero.chartTitlePrefix} {dict.products[slug].full} (
                      {dict.units.xofPerKg})
                    </title>

                    <!-- Shaded 3-Month Forecast Zone Backdrop -->
                    <rect
                      x={heroGeom.asOfX}
                      y={heroGeom.margin.top}
                      width={heroGeom.forecastZoneWidth}
                      height={heroGeom.height - heroGeom.margin.top - heroGeom.margin.bottom}
                      class="forecast-zone-bg"
                    />

                    <!-- Horizontal Y Gridlines & Labels -->
                    {heroGeom.yTicks.map((t) => (
                      <g class="axis-tick">
                        <line
                          x1={heroGeom.margin.left}
                          x2={heroGeom.forecastEndX}
                          y1={t.y}
                          y2={t.y}
                          class="grid-line"
                        />
                        <text
                          x={heroGeom.margin.left - 8}
                          y={t.y + 4}
                          text-anchor="end"
                          class="axis-text tabular-nums"
                        >
                          {formatInt(t.value, locale)}
                        </text>
                      </g>
                    ))}

                    <!-- Vertical X Year Ticks -->
                    {heroGeom.xTicks.map((xt) => (
                      <g class="axis-tick">
                        <line
                          x1={xt.x}
                          x2={xt.x}
                          y1={heroGeom.height - heroGeom.margin.bottom}
                          y2={heroGeom.height - heroGeom.margin.bottom + 5}
                          class="tick-mark"
                        />
                        <text
                          x={xt.x}
                          y={heroGeom.height - 8}
                          text-anchor="middle"
                          class="axis-text tabular-nums"
                        >
                          {xt.year}
                        </text>
                      </g>
                    ))}

                    <!-- As-of vertical divider line (sept. 2026) -->
                    <line
                      x1={heroGeom.asOfX}
                      x2={heroGeom.asOfX}
                      y1={heroGeom.margin.top}
                      y2={heroGeom.height - heroGeom.margin.bottom}
                      class="asof-line"
                    />
                    <text
                      x={heroGeom.asOfX - 6}
                      y={heroGeom.margin.top + 11}
                      text-anchor="end"
                      class="asof-label tabular-nums"
                    >
                      {dict.home.hero.chartAsOfMarker}
                    </text>
                    <text
                      x={heroGeom.asOfX + heroGeom.forecastZoneWidth / 2}
                      y={heroGeom.margin.top + 11}
                      text-anchor="middle"
                      class="forecast-zone-label tabular-nums"
                    >
                      {dict.home.hero.chartHorizonMarker}
                    </text>

                    <!-- Forecast Uncertainty Bands & Dashed Forecast Trajectory Group -->
                    <g class="hero-forecast-group" data-asof-x={heroGeom.asOfX}>
                      <path d={heroGeom.band90Path} class={`fan-band-90 band-${slug}`} />
                      <path d={heroGeom.band80Path} class={`fan-band-80 band-${slug}`} />
                      {slug === 'maize_white' && (
                        <path d={heroGeom.forecastPath} class="line-forecast-casing" />
                      )}
                      <path d={heroGeom.forecastPath} class={`line-forecast stroke-${slug}`} />
                    </g>

                    <!-- Historical Observed Trajectory (breaks at unobserved months via d3.line().defined()) -->
                    {slug === 'maize_white' && (
                      <path d={heroGeom.historyPath} class="line-history-casing" />
                    )}
                    <path d={heroGeom.historyPath} class={`line-history stroke-${slug}`} />

                    <!-- 1. Direct Annotation: Historical Observed Peak -->
                    {heroGeom.peakPoint && (
                      <g class="hero-annotation hero-peak-annotation">
                        <line
                          x1={heroGeom.peakPoint.x}
                          y1={heroGeom.peakPoint.y - 4}
                          x2={heroGeom.peakPoint.x}
                          y2={heroGeom.peakPoint.labelY + 4}
                          class="annotation-leader"
                        />
                        <circle
                          cx={heroGeom.peakPoint.x}
                          cy={heroGeom.peakPoint.y}
                          r="4"
                          class={`dot-peak fill-${slug}`}
                        />
                        <text
                          x={heroGeom.peakPoint.labelX}
                          y={heroGeom.peakPoint.labelY}
                          text-anchor={heroGeom.peakPoint.anchor}
                          class="curve-annotation-text tabular-nums"
                        >
                          {dict.home.hero.peakLabelPrefix}{' '}
                          {formatInt(heroGeom.peakPoint.price, locale)} {dict.units.xofPerKg} (
                          {peakDateShort})
                        </text>
                      </g>
                    )}

                    <!-- 2. Direct Annotation: Last Observed Anchor Point (sept. 2026) -->
                    {heroGeom.lastObsPoint && (
                      <g class="hero-annotation hero-anchor-annotation">
                        <line
                          x1={heroGeom.lastObsPoint.x}
                          y1={heroGeom.lastObsPoint.y + 4}
                          x2={heroGeom.lastObsPoint.labelX + 3}
                          y2={heroGeom.lastObsPoint.labelY - 9}
                          class="annotation-leader"
                        />
                        <circle
                          cx={heroGeom.lastObsPoint.x}
                          cy={heroGeom.lastObsPoint.y}
                          r="4.5"
                          class={`dot-anchor fill-${slug}`}
                        />
                        <text
                          x={heroGeom.lastObsPoint.labelX}
                          y={heroGeom.lastObsPoint.labelY}
                          text-anchor="end"
                          class="curve-annotation-text tabular-nums"
                        >
                          {lastObsDateShort} · {formatDecimal(prod.dantokpa.last_observed_price, locale, 1)}{' '}
                          {dict.units.xofPerKg}
                        </text>
                      </g>
                    )}

                    <!-- Forecast Horizon Dots (1, 2, 3 months) -->
                    <g class="hero-forecast-dots">
                      {heroGeom.forecastPoints.map((fp) => (
                        <circle
                          cx={fp.x}
                          cy={fp.y}
                          r="3.5"
                          class={`dot-forecast stroke-${slug}`}
                        />
                      ))}
                    </g>

                    <!-- 3. Direct Annotations: 80%/90% Fan Band & 3-Month Forecast Endpoint -->
                    <g class="hero-annotation hero-forecast-annotations">
                      {heroGeom.bandLabelPos && (
                        <>
                          <line
                            x1={heroGeom.bandLabelPos.tickX1}
                            y1={heroGeom.bandLabelPos.tickY1}
                            x2={heroGeom.bandLabelPos.tickX2}
                            y2={heroGeom.bandLabelPos.labelY - 3}
                            class="annotation-leader"
                          />
                          <text
                            x={heroGeom.bandLabelPos.labelX}
                            y={heroGeom.bandLabelPos.labelY}
                            text-anchor="start"
                            class="curve-annotation-sub tabular-nums"
                          >
                            {dict.home.hero.bandDirectLabel}
                          </text>
                        </>
                      )}
                      {heroGeom.forecastEndLabelPos && (
                        <>
                          <text
                            x={heroGeom.forecastEndLabelPos.x}
                            y={heroGeom.forecastEndLabelPos.yLine1}
                            text-anchor="start"
                            class="curve-annotation-text tabular-nums"
                          >
                            {fc3DateShort} · {formatDecimal(fcH3.point_forecast, locale, 1)}{' '}
                            {dict.units.xofPerKg}
                          </text>
                          <text
                            x={heroGeom.forecastEndLabelPos.x}
                            y={heroGeom.forecastEndLabelPos.yLine2}
                            text-anchor="start"
                            class="curve-annotation-sub tabular-nums"
                          >
                            [{formatInt(fcH3.low_80, locale)}–{formatInt(fcH3.high_80, locale)}{' '}
                            {dict.units.xofPerKg}]
                          </text>
                        </>
                      )}
                    </g>
                  </svg>
                </div>

                <!-- Minimal Typographic 4-Column Key Indicators Row (Fraunces Display + Thin Rules) -->
                <div class="kpi-strip tabular-nums">
                  <div class="kpi-cell">
                    <span class="kpi-label">{dict.home.hero.latestObservedLabel}</span>
                    <strong class="kpi-value kpi-display-num nowrap">
                      {formatDecimal(prod.dantokpa.last_observed_price, locale, 1)}{' '}
                      <small class="kpi-unit nowrap">{dict.units.xofPerKg}</small>
                    </strong>
                  </div>
                  <div class="kpi-cell">
                    <span class="kpi-label">{dict.home.hero.forecastH3Label}</span>
                    <strong class="kpi-value kpi-display-num">
                      <span class="nowrap">
                        {formatDecimal(fcH3.point_forecast, locale, 1)}{' '}
                        <small class="kpi-unit nowrap">{dict.units.xofPerKg}</small>
                      </span>{' '}
                      <span class="kpi-delta nowrap">
                        ({formatSignedPct(fcH3.change_vs_last_pct, locale, 1)})
                      </span>
                    </strong>
                  </div>
                  <div class="kpi-cell">
                    <span class="kpi-label">{dict.home.hero.interval80Label}</span>
                    <strong class="kpi-value kpi-display-num nowrap">
                      [{formatInt(fcH3.low_80, locale)}, {formatInt(fcH3.high_80, locale)}]{' '}
                      <small class="kpi-unit nowrap">{dict.units.xofPerKg}</small>
                    </strong>
                  </div>
                  <div class="kpi-cell">
                    <span class="kpi-label">{dict.home.hero.modelUsedLabel}</span>
                    <strong class="kpi-value kpi-method">{modelH3Plain}</strong>
                  </div>
                </div>

                <!-- Minimal Honesty & Reliability Line: Editorial Status Tag + One Plain Headline Sentence + Details Tooltip -->
                <div class="honesty-strip">
                  <span class="reliability-badge" data-status={relH3.status}>
                    {relLabel}
                  </span>
                  <p class="honesty-note">
                    {headlineH3}{' '}
                    <button
                      type="button"
                      class="details-tooltip-trigger"
                      title={detailedTooltipH3}
                      aria-label={`${dict.home.hero.detailsTriggerLabel} : ${detailedTooltipH3}`}
                    >
                      {dict.home.hero.detailsTriggerLabel}
                    </button>
                  </p>
                </div>

                <!-- Accessible Data Table Drawer -->
                <details class="data-drawer">
                  <summary>{dict.home.hero.tableToggle}</summary>
                  <div class="table-scroll">
                    <table class="ledger-table">
                      <thead>
                        <tr>
                          <th>{dict.home.hero.tableDate}</th>
                          <th>{dict.home.hero.tableStatus}</th>
                          <th class="num">{dict.home.hero.tablePrice}</th>
                          <th class="num">{dict.home.hero.tableInterval80}</th>
                          <th class="num">{dict.home.hero.tableInterval90}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {recentHistory12.map((pt) => (
                          <tr>
                            <td>{formatYearMonth(pt.date, dict)}</td>
                            <td>
                              {pt.is_observed !== false && pt.price !== null
                                ? dict.home.hero.statusObserved
                                : dict.home.hero.statusUnobserved}
                            </td>
                            <td class="num">
                              {pt.is_observed !== false && pt.price !== null
                                ? formatDecimal(pt.price, locale, 1)
                                : '—'}
                            </td>
                            <td class="num">—</td>
                            <td class="num">—</td>
                          </tr>
                        ))}
                        {prod.dantokpa.forecasts.map((fc) => {
                          const horizonLabel = dict.home.hero.horizonAtMonths.replace(
                            '{h}',
                            String(fc.horizon_months)
                          );
                          const fcRelLabel =
                            dict.reliability[fc.reliability as keyof typeof dict.reliability] ??
                            fc.reliability;
                          return (
                            <tr class="forecast-row">
                              <td>
                                {formatYearMonth(fc.target_date, dict)} ({horizonLabel})
                              </td>
                              <td>
                                <strong>{dict.home.hero.statusForecast}</strong> ·{' '}
                                {formatModelName(fc.model_used, dict)} ({fcRelLabel})
                              </td>
                              <td class="num">
                                <strong>{formatDecimal(fc.point_forecast, locale, 1)}</strong>
                              </td>
                              <td class="num">
                                [{formatDecimal(fc.low_80, locale, 1)},{' '}
                                {formatDecimal(fc.high_80, locale, 1)}]
                              </td>
                              <td class="num">
                                [{formatDecimal(fc.low_90, locale, 1)},{' '}
                                {formatDecimal(fc.high_90, locale, 1)}]
                              </td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                </details>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<!-- =======================================================================
     2. SECTION: "Trois produits, trois histoires" (Open Editorial Columns + Sparkline Draw)
     ======================================================================= -->
<section class="section-block stories-section" aria-labelledby="stories-heading">
  <div class="container">
    <header class="section-header" data-reveal="fade-up">
      <h2 class="section-title" id="stories-heading">{dict.home.stories.title}</h2>
      <p class="section-subtitle">{dict.home.stories.subtitle}</p>
    </header>

    <div class="grid-12 stories-grid stories-subgrid">
      {
        productViews.map(
          ({ slug, prod, sparkGeom, peakMonthName, troughMonthName, computedStoryProse }) => (
            <article class={`story-card card-accent-${slug}`} data-reveal="fade-up">
              <header class="story-card-header">
                <div class="story-card-title-row">
                  <span class={`product-pill pill-${slug}`}>{dict.products[slug].chip}</span>
                  <span
                    class="story-market-count tabular-nums"
                    title={dict.units.marketsDefinitionNote}
                  >
                    {prod.tier1_markets_count} {dict.units.marketsCount} ·{' '}
                    {formatInt(prod.observed_market_months, locale)} {dict.units.obsMonthsCount}
                  </span>
                </div>
                <h3 class="story-card-title">{dict.products[slug].full}</h3>
                <p class="story-card-prose">{computedStoryProse}</p>
              </header>

              <!-- Unboxed 36-Month Tracked-Market Median Sparkline (D3 SVG) -->
              <div class="sparkline-box">
                <div class="sparkline-meta tabular-nums">
                  <span>{dict.home.stories.sparklineCaption}</span>
                  <span class="sparkline-range nowrap">
                    min {formatInt(sparkGeom.minVal, locale)} – max{' '}
                    {formatInt(sparkGeom.maxVal, locale)} {dict.units.xofPerKg}
                  </span>
                </div>
                <svg
                  viewBox="0 0 300 68"
                  class="sparkline-svg"
                  role="img"
                  aria-label={`${dict.home.stories.sparklineCaption} — ${dict.products[slug].full}`}
                >
                  <path d={sparkGeom.areaPath} class={`spark-area band-${slug}`} />
                  {slug === 'maize_white' && (
                    <path d={sparkGeom.linePath} class="spark-line-casing" />
                  )}
                  <path d={sparkGeom.linePath} class={`spark-line stroke-${slug}`} />
                  <circle
                    cx={sparkGeom.lastX}
                    cy={sparkGeom.lastY}
                    r="4"
                    class={`dot-anchor fill-${slug}`}
                  />
                </svg>
                <p class="sparkline-scale-note">{dict.home.stories.sparklineScaleNote}</p>
              </div>

              <!-- Data-Computed Seasonal & Price Stats with Large Typographic Figures -->
              <dl class="story-stats-grid tabular-nums">
                <div class="story-stat-item">
                  <dt>{dict.home.stories.latestMedianLabel}</dt>
                  <dd>
                    <strong class="stat-display-num nowrap">
                      {formatDecimal(prod.latest_national_stats.median_price, locale, 1)}{' '}
                      <small>{dict.units.xofPerKg}</small>
                    </strong>
                  </dd>
                </div>
                <div class="story-stat-item">
                  <dt>{dict.home.stories.dantokpaLatestLabel}</dt>
                  <dd>
                    <strong class="stat-display-num nowrap">
                      {formatDecimal(prod.dantokpa.last_observed_price, locale, 1)}{' '}
                      <small>{dict.units.xofPerKg}</small>
                    </strong>
                  </dd>
                </div>
                <div class="story-stat-item">
                  <dt>{dict.home.stories.seasonalPeakLabel}</dt>
                  <dd>
                    <strong>{peakMonthName}</strong> (
                    <span class="tooltip-term" title={dict.home.stories.indexTooltip}>
                      {dict.home.stories.indexUnit}{' '}
                      {formatDecimal(prod.seasonality.peak_index, locale, 1)}
                    </span>
                    )
                  </dd>
                </div>
                <div class="story-stat-item">
                  <dt>{dict.home.stories.seasonalTroughLabel}</dt>
                  <dd>
                    <strong>{troughMonthName}</strong> (
                    <span class="tooltip-term" title={dict.home.stories.indexTooltip}>
                      {dict.home.stories.indexUnit}{' '}
                      {formatDecimal(prod.seasonality.trough_index, locale, 1)}
                    </span>
                    )
                  </dd>
                </div>
                <div class="story-stat-item story-stat-wide">
                  <dt>{dict.home.stories.seasonalSpreadLabel}</dt>
                  <dd>
                    <strong>
                      {formatSignedPct(
                        prod.seasonality.spread_pct_num ??
                          parseFloat(String(prod.seasonality.spread_pct).replace('%', '')),
                        locale,
                        1
                      )}
                    </strong>{' '}
                    ({formatDecimal(prod.seasonality.spread_pts, locale, 1)}{' '}
                    {dict.units.indexPoints}, {dict.home.stories.indexTooltip})
                  </dd>
                </div>
              </dl>

              <footer class="story-card-footer">
                <a href={`${routes.explorer}?product=${slug}`} class="story-link">
                  {dict.products[slug].exploreHistoryCta}
                </a>
              </footer>
            </article>
          )
        )
      }
    </div>
  </div>
</section>

<!-- =======================================================================
     3. SECTION: "Un même kilo, des prix différents" (Full-Bleed Dark Ink Section)
     ======================================================================= -->
<section class="section-block map-section-dark" id="map-section-root" aria-labelledby="map-section-heading">
  <div class="container">
    <header class="section-header map-section-header" data-reveal="fade-up">
      <div>
        <h2 class="section-title map-dark-title" id="map-section-heading">
          {dict.home.mapSection.title}
        </h2>
        <p class="section-subtitle map-dark-subtitle">{dict.home.mapSection.subtitle}</p>
      </div>
      <div>
        <span class="selector-label map-dark-label" id="map-product-selector-label">
          {dict.home.mapSection.productFilterLabel}
        </span>
        <div class="chip-group" role="group" aria-labelledby="map-product-selector-label">
          {
            productOrder.map((slug, idx) => (
              <button
                type="button"
                class="product-chip map-dark-chip"
                data-product={slug}
                data-role="product-switch"
                aria-pressed={idx === 0 ? 'true' : 'false'}
              >
                <span class="chip-swatch" aria-hidden="true" />
                <span>{dict.products[slug].chip}</span>
              </button>
            ))
          }
        </div>
      </div>
    </header>

    {
      productViews.map(({ slug, prod, mapGeom }, idx) => {
        const isDefault = idx === 0;
        const defaultMarket =
          mapGeom.nodes.find((n) => n.market_name === 'Dantokpa') ?? mapGeom.nodes[0];
        const defaultCoords = `${formatDecimal(defaultMarket.latitude, locale, 2)}°N, ${formatDecimal(defaultMarket.longitude, locale, 2)}°E`;
        const stepLabels = [
          dict.home.mapSection.step1Label,
          dict.home.mapSection.step2Label,
          dict.home.mapSection.step3Label,
          dict.home.mapSection.step4Label,
          dict.home.mapSection.step5Label,
        ];

        return (
          <div class="map-product-panel" data-map-panel={slug} hidden={!isDefault}>
            <div class="grid-12 map-layout-grid">
              <!-- Dot Map Canvas (Cols 1-5) Directly on Dark Ink -->
              <div class="map-canvas-col">
                <div class="map-legend-block">
                  <p class="map-ramp-explanation">{dict.home.mapSection.rampExplanation}</p>
                  <div class="map-legend-bar tabular-nums">
                    {mapGeom.rampColors.map((hex, sIdx) => (
                      <span class="map-legend-item">
                        <span
                          class="map-dot-swatch"
                          style={`background-color: ${hex};`}
                          aria-hidden="true"
                        />
                        <span>{stepLabels[sIdx]}</span>
                      </span>
                    ))}
                  </div>
                </div>

                <div class="dotmap-svg-wrap" data-map-wrap={slug}>
                  <svg
                    viewBox={`0 0 ${mapGeom.width} ${mapGeom.height}`}
                    class="dotmap-svg"
                    role="img"
                    aria-label={`${dict.home.mapSection.title} — ${dict.products[slug].full}`}
                  >
                    <title>
                      {dict.home.mapSection.title} — {dict.products[slug].full}
                    </title>

                    <!-- Latitude reference lines (left gutter for localized latitude band labels) -->
                    {mapGeom.latBands.map((lb) => (
                      <g>
                        <line
                          x1={mapGeom.mapLeft}
                          x2={mapGeom.mapRight}
                          y1={lb.y}
                          y2={lb.y}
                          class="map-grid-line"
                        />
                        <text x="10" y={lb.y + 4} class="map-axis-text tabular-nums">
                          {lb.label}
                        </text>
                      </g>
                    ))}

                    <!-- Market Dots ordered South-to-North with <=6px collision relaxation & crisp sand stroke -->
                    {mapGeom.nodes.map((node) => {
                      const isDantokpa = node.market_name === defaultMarket.market_name;
                      const zonePlain = formatZoneName(node.agro_zone, dict);
                      const coordsFormatted = `${formatDecimal(node.latitude, locale, 2)}°N, ${formatDecimal(node.longitude, locale, 2)}°E`;
                      return (
                        <g
                          class="map-market-node"
                          tabindex="0"
                          role="button"
                          aria-label={`${node.market_name} (${node.department}, ${zonePlain}, ${coordsFormatted}) : ${formatDecimal(node.last_observed_price, locale, 1)} ${dict.units.xofPerKg} (${formatSignedPct(node.diff_vs_median_pct, locale, 1)})`}
                          data-market-node={slug}
                          data-market-name={node.market_name}
                          data-department={node.department}
                          data-zone={zonePlain}
                          data-coords={coordsFormatted}
                          data-cx={node.cx}
                          data-cy={node.cy}
                          data-price={formatDecimal(node.last_observed_price, locale, 1)}
                          data-diff={formatSignedPct(node.diff_vs_median_pct, locale, 1)}
                          data-h3={`${formatDecimal(node.h3_forecast, locale, 1)} [${formatInt(node.h3_low_80, locale)}, ${formatInt(node.h3_high_80, locale)}]`}
                          data-mape={
                            node.h3_test_mape !== null
                              ? formatPct(node.h3_test_mape, locale, 1)
                              : '—'
                          }
                          data-active={isDantokpa ? 'true' : 'false'}
                        >
                          <circle cx={node.cx} cy={node.cy} r="12" class="map-hit-target" />
                          <circle
                            cx={node.cx}
                            cy={node.cy}
                            r={
                              node.isCheapest || node.isPriciest
                                ? '7'
                                : isDantokpa
                                  ? '6.5'
                                  : '5.5'
                            }
                            fill={node.fillHex}
                            class="map-dot"
                          />
                        </g>
                      );
                    })}

                    <!-- Direct Callout Labels for Cheapest & Most Expensive Markets -->
                    {[
                      {
                        callout: mapGeom.cheapestCallout,
                        prefix: dict.home.mapSection.cheapestCalloutPrefix,
                      },
                      {
                        callout: mapGeom.priciestCallout,
                        prefix: dict.home.mapSection.priciestCalloutPrefix,
                      },
                    ].map(({ callout, prefix }) => (
                      <g class="map-extremum-callout" pointer-events="none">
                        <path d={callout.leaderPath} class="callout-leader-dark" />
                        <text
                          x={callout.labelX}
                          y={callout.labelY}
                          text-anchor={callout.anchor}
                          class="callout-text-dark tabular-nums"
                        >
                          {prefix} {callout.node.market_name} (
                          {formatInt(callout.node.last_observed_price, locale)}{' '}
                          {dict.units.xofPerKg})
                        </text>
                      </g>
                    ))}
                  </svg>

                  <!-- Floating Interactive Tooltip on Map Canvas (Hover, Tap, Keyboard Focus) -->
                  <div
                    class="map-floating-tooltip tabular-nums"
                    data-map-tooltip={slug}
                    role="status"
                    aria-live="polite"
                    hidden
                  >
                    <div class="tooltip-top-row">
                      <strong class="tooltip-market-name" data-tt-field="name">
                        {defaultMarket.market_name}
                      </strong>
                      <span class="tooltip-coords" data-tt-field="coords">
                        {defaultCoords}
                      </span>
                    </div>
                    <p class="tooltip-region" data-tt-field="meta">
                      {defaultMarket.department} · {formatZoneName(defaultMarket.agro_zone, dict)}
                    </p>
                    <div class="tooltip-metrics">
                      <div>
                        <span class="tooltip-label">{dict.home.mapSection.latestPriceLabel} :</span>{' '}
                        <strong data-tt-field="price">
                          {formatDecimal(defaultMarket.last_observed_price, locale, 1)}
                        </strong>{' '}
                        {dict.units.xofPerKg} (<span data-tt-field="diff">
                          {formatSignedPct(defaultMarket.diff_vs_median_pct, locale, 1)}
                        </span>)
                      </div>
                      <div>
                        <span class="tooltip-label">
                          {dict.home.mapSection.forecastH3MapLabel} :
                        </span>{' '}
                        <strong data-tt-field="h3">
                          {formatDecimal(defaultMarket.h3_forecast, locale, 1)} [
                          {formatInt(defaultMarket.h3_low_80, locale)},{' '}
                          {formatInt(defaultMarket.h3_high_80, locale)}]
                        </strong>{' '}
                        {dict.units.xofPerKg}
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Spatial Summary & Interactive Market Inspector (Cols 6-12) Directly on Dark Ink -->
              <div class="map-inspector-col">
                <div class="spatial-summary-block tabular-nums" data-reveal="fade-up">
                  <div class="spatial-kpi-grid">
                    <div class="spatial-kpi-cell">
                      <span class="kpi-label map-dark-label">
                        {dict.home.mapSection.nationalMedianStat}
                      </span>
                      <strong class="spatial-display-num nowrap">
                        {formatDecimal(prod.latest_national_stats.median_price, locale, 1)}{' '}
                        <small class="nowrap">{dict.units.xofPerKg}</small>
                      </strong>
                    </div>
                    <div class="spatial-kpi-cell">
                      <span class="kpi-label map-dark-label">
                        {dict.home.mapSection.spreadRatioStat}
                      </span>
                      <strong class="spatial-display-num nowrap">
                        {formatDecimal(prod.latest_national_stats.max_min_ratio, locale, 2)}×
                      </strong>
                    </div>
                    <div class="spatial-kpi-cell">
                      <span class="kpi-label map-dark-label">
                        {dict.home.mapSection.lowestMarketStat}
                      </span>
                      <strong class="spatial-sub-num">
                        {prod.latest_national_stats.min_market_name}{' '}
                        <span class="nowrap">
                          ({formatDecimal(prod.latest_national_stats.min_price, locale, 1)}{' '}
                          {dict.units.xofPerKg})
                        </span>
                      </strong>
                    </div>
                    <div class="spatial-kpi-cell">
                      <span class="kpi-label map-dark-label">
                        {dict.home.mapSection.highestMarketStat}
                      </span>
                      <strong class="spatial-sub-num">
                        {prod.latest_national_stats.max_market_name}{' '}
                        <span class="nowrap">
                          ({formatDecimal(prod.latest_national_stats.max_price, locale, 1)}{' '}
                          {dict.units.xofPerKg})
                        </span>
                      </strong>
                    </div>
                  </div>
                  <p class="spatial-month-note">{dict.home.mapSection.latestMonthOnlyNote}</p>
                </div>

                <div
                  class={`market-detail-block card-accent-${slug}`}
                  data-market-inspector={slug}
                  data-reveal="fade-up"
                >
                  <div class="inspector-header-row">
                    <div>
                      <span class="kpi-label map-dark-label">
                        {dict.home.mapSection.selectedMarketHeading}
                      </span>
                      <h3 class="inspector-market-title" data-field="name">
                        {defaultMarket.market_name}
                      </h3>
                    </div>
                    <span class="inspector-coords-pill tabular-nums" data-field="coords">
                      {defaultCoords}
                    </span>
                  </div>
                  <p class="inspector-hint">{dict.home.mapSection.selectedMarketHint}</p>

                  <dl class="story-stats-grid map-dark-stats-grid tabular-nums">
                    <div class="story-stat-item">
                      <dt>{dict.home.mapSection.departmentLabel}</dt>
                      <dd data-field="department">{defaultMarket.department}</dd>
                    </div>
                    <div class="story-stat-item">
                      <dt>{dict.home.mapSection.zoneLabel}</dt>
                      <dd data-field="zone">{formatZoneName(defaultMarket.agro_zone, dict)}</dd>
                    </div>
                    <div class="story-stat-item">
                      <dt>{dict.home.mapSection.latestPriceLabel}</dt>
                      <dd class="nowrap">
                        <strong class="stat-display-num-dark" data-field="price">
                          {formatDecimal(defaultMarket.last_observed_price, locale, 1)}
                        </strong>{' '}
                        {dict.units.xofPerKg}
                      </dd>
                    </div>
                    <div class="story-stat-item">
                      <dt>{dict.home.mapSection.diffVsMedianLabel}</dt>
                      <dd>
                        <strong class="stat-display-num-dark" data-field="diff">
                          {formatSignedPct(defaultMarket.diff_vs_median_pct, locale, 1)}
                        </strong>
                      </dd>
                    </div>
                    <div class="story-stat-item story-stat-wide-mobile">
                      <dt>{dict.home.mapSection.forecastH3MapLabel}</dt>
                      <dd class="nowrap">
                        <strong data-field="h3">
                          {formatDecimal(defaultMarket.h3_forecast, locale, 1)} [
                          {formatInt(defaultMarket.h3_low_80, locale)},{' '}
                          {formatInt(defaultMarket.h3_high_80, locale)}]
                        </strong>{' '}
                        <span class="nowrap">{dict.units.xofPerKg}</span>
                      </dd>
                    </div>
                    <div class="story-stat-item story-stat-wide-mobile">
                      <dt>
                        <span
                          class="tooltip-term"
                          title={dict.home.mapSection.holdoutMapeTooltip}
                          tabindex="0"
                        >
                          {dict.home.mapSection.holdoutMapeLabel}
                        </span>
                      </dt>
                      <dd data-field="mape">
                        {defaultMarket.h3_test_mape !== null
                          ? formatPct(defaultMarket.h3_test_mape, locale, 1)
                          : '—'}
                      </dd>
                    </div>
                  </dl>
                </div>

                <!-- Accessible Table Alternative for All Well-Tracked Markets (Dark Ink Theme) -->
                <details class="data-drawer map-dark-drawer">
                  <summary>
                    {dict.home.mapSection.tableAlternativeToggle} ({prod.tier1_markets_count})
                  </summary>
                  <div class="table-scroll">
                    <table class="ledger-table map-dark-table">
                      <thead>
                        <tr>
                          <th>{dict.home.mapSection.colMarket}</th>
                          <th>{dict.home.mapSection.colDepartment}</th>
                          <th>{dict.home.mapSection.colZone}</th>
                          <th class="num">{dict.home.mapSection.colCoords}</th>
                          <th class="num">{dict.home.mapSection.colLatestPrice}</th>
                          <th class="num">{dict.home.mapSection.colDiffMedian}</th>
                          <th class="num">{dict.home.mapSection.colForecastH3}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {mapGeom.nodes.map((m) => (
                          <tr>
                            <td>
                              <strong>{m.market_name}</strong>
                            </td>
                            <td>{m.department}</td>
                            <td>{formatZoneName(m.agro_zone, dict)}</td>
                            <td class="num nowrap">
                              {formatDecimal(m.latitude, locale, 2)}°N,{' '}
                              {formatDecimal(m.longitude, locale, 2)}°E
                            </td>
                            <td class="num nowrap">
                              {formatDecimal(m.last_observed_price, locale, 1)}
                            </td>
                            <td class="num nowrap">
                              {formatSignedPct(m.diff_vs_median_pct, locale, 1)}
                            </td>
                            <td class="num nowrap">
                              {formatDecimal(m.h3_forecast, locale, 1)} [
                              {formatInt(m.h3_low_80, locale)}, {formatInt(m.h3_high_80, locale)}]
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </details>
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<!-- =======================================================================
     4. SECTION: "Ce que disent les prévisions" (Open Editorial Columns + One Plain Headline Sentence)
     ======================================================================= -->
<section class="section-block teaser-section" aria-labelledby="teaser-heading">
  <div class="container">
    <header class="section-header" data-reveal="fade-up">
      <h2 class="section-title" id="teaser-heading">{dict.home.forecastTeaser.title}</h2>
      <p class="section-subtitle">{dict.home.forecastTeaser.subtitle}</p>
    </header>

    <div class="grid-12 stories-grid teaser-subgrid">
      {
        productViews.map(
          ({
            slug,
            fcH1,
            fcH2,
            fcH3,
            relH1,
            relH2,
            relH3,
            headlineH3,
            detailedTooltipH3,
          }) => {
            const relLabelH1 =
              dict.reliability[relH1.status as keyof typeof dict.reliability] ?? relH1.status;
            const relLabelH2 =
              dict.reliability[relH2.status as keyof typeof dict.reliability] ?? relH2.status;
            const relLabelH3 =
              dict.reliability[relH3.status as keyof typeof dict.reliability] ?? relH3.status;
            const modelH3Plain = formatModelName(fcH3.model_used, dict);

            return (
              <article class={`story-card card-accent-${slug}`} data-reveal="fade-up">
                <header class="story-card-header">
                  <div class="story-card-title-row">
                    <span class={`product-pill pill-${slug}`}>{dict.products[slug].chip}</span>
                    <span class="reliability-badge" data-status={relH3.status}>
                      {relLabelH3}
                    </span>
                  </div>
                  <h3 class="story-card-title">
                    Dantokpa · {dict.products[slug].full}
                  </h3>
                </header>

                <dl class="story-stats-grid tabular-nums">
                  <div class="story-stat-item">
                    <dt>{dict.home.forecastTeaser.horizon1Label}</dt>
                    <dd>
                      <strong class="stat-display-num nowrap">
                        {formatDecimal(fcH1.point_forecast, locale, 1)}{' '}
                        <small>{dict.units.xofPerKg}</small>
                      </strong>{' '}
                      <span class="nowrap">
                        ({formatSignedPct(fcH1.change_vs_last_pct, locale, 1)})
                      </span>
                      <span class="horizon-rel-tag">{relLabelH1}</span>
                    </dd>
                  </div>
                  <div class="story-stat-item">
                    <dt>{dict.home.forecastTeaser.horizon2Label}</dt>
                    <dd>
                      <strong class="stat-display-num nowrap">
                        {formatDecimal(fcH2.point_forecast, locale, 1)}{' '}
                        <small>{dict.units.xofPerKg}</small>
                      </strong>{' '}
                      <span class="nowrap">
                        ({formatSignedPct(fcH2.change_vs_last_pct, locale, 1)})
                      </span>
                      <span class="horizon-rel-tag">{relLabelH2}</span>
                    </dd>
                  </div>
                  <div class="story-stat-item story-stat-wide">
                    <dt>{dict.home.forecastTeaser.horizon3Label}</dt>
                    <dd>
                      <strong class="stat-display-num nowrap">
                        {formatDecimal(fcH3.point_forecast, locale, 1)}{' '}
                        <small>{dict.units.xofPerKg}</small>
                      </strong>{' '}
                      · {dict.home.hero.legendBand80}{' '}
                      <span class="nowrap">
                        [{formatInt(fcH3.low_80, locale)}, {formatInt(fcH3.high_80, locale)}]{' '}
                        {dict.units.xofPerKg}
                      </span>
                      <span class="horizon-rel-tag">{relLabelH3}</span>
                    </dd>
                  </div>
                  <div class="story-stat-item story-stat-wide">
                    <dt>{dict.home.forecastTeaser.modelLabel}</dt>
                    <dd>
                      <strong>{modelH3Plain}</strong>
                    </dd>
                  </div>
                </dl>

                <!-- One Plain Headline Sentence + Accessible Test Details Tooltip Trigger -->
                <p class="teaser-note">
                  {headlineH3}{' '}
                  <button
                    type="button"
                    class="details-tooltip-trigger"
                    title={detailedTooltipH3}
                    aria-label={`${dict.home.hero.detailsTriggerLabel} : ${detailedTooltipH3}`}
                  >
                    {dict.home.hero.detailsTriggerLabel}
                  </button>
                </p>

                <footer class="story-card-footer">
                  <a href={`${routes.forecast}?product=${slug}`} class="story-link">
                    {dict.products[slug].forecastCta}
                  </a>
                </footer>
              </article>
            );
          }
        )
      }
    </div>

    <div class="btn-row">
      <a href={routes.forecast} class="btn btn-primary">
        {dict.home.forecastTeaser.openForecastPageCta}
      </a>
      <a href={routes.method} class="btn btn-secondary">
        {dict.home.forecastTeaser.openMethodPageCta}
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  interface MorphProductEntry {
    x93: number[];
    y93: number[];
    def93: number[];
    fcBridge: Array<{
      x: number;
      y: number;
      l80: number;
      h80: number;
      l90: number;
      h90: number;
    }>;
    historyPath: string;
    forecastPath: string;
    band80Path: string;
    band90Path: string;
    peak: { x: number; y: number };
    lastObs: { x: number; y: number };
    fcDots: Array<{ x: number; y: number }>;
  }

  const heroRoot = document.getElementById('hero-root');
  const morphMap: Record<string, MorphProductEntry> = heroRoot?.dataset.heroMorph
    ? JSON.parse(heroRoot.dataset.heroMorph)
    : {};

  const switchBtns = document.querySelectorAll<HTMLButtonElement>('[data-role="product-switch"]');
  const heroPanels = document.querySelectorAll<HTMLElement>('[data-product-panel]');
  const mapPanels = document.querySelectorAll<HTMLElement>('[data-map-panel]');

  let currentProduct = heroRoot?.dataset.activeProduct || 'maize_white';
  let activeMorphTween: gsap.core.Tween | null = null;

  const isReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function buildInterpolatedHistoryPath(
    xArr: number[],
    fromY: number[],
    toY: number[],
    defArr: number[],
    t: number
  ): string {
    let d = '';
    let inSubpath = false;
    for (let i = 0; i < xArr.length; i++) {
      if (!defArr[i]) {
        inSubpath = false;
        continue;
      }
      const x = xArr[i];
      const y = Math.round((fromY[i] + (toY[i] - fromY[i]) * t) * 10) / 10;
      if (!inSubpath) {
        d += `M${x},${y}`;
        inSubpath = true;
      } else {
        d += `L${x},${y}`;
      }
    }
    return d;
  }

  function buildInterpolatedForecastPaths(
    fromFc: MorphProductEntry['fcBridge'],
    toFc: MorphProductEntry['fcBridge'],
    t: number
  ): { fcLine: string; b80: string; b90: string } {
    const pts = toFc.map((pt, idx) => {
      const f = fromFc[idx] ?? pt;
      const lerp = (a: number, b: number) => Math.round((a + (b - a) * t) * 10) / 10;
      return {
        x: pt.x,
        y: lerp(f.y, pt.y),
        l80: lerp(f.l80, pt.l80),
        h80: lerp(f.h80, pt.h80),
        l90: lerp(f.l90, pt.l90),
        h90: lerp(f.h90, pt.h90),
      };
    });

    const fcLine = pts.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x},${p.y}`).join('');
    const b80Top = pts.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x},${p.h80}`).join('');
    const b80Bot = [...pts]
      .reverse()
      .map((p) => `L${p.x},${p.l80}`)
      .join('');
    const b90Top = pts.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x},${p.h90}`).join('');
    const b90Bot = [...pts]
      .reverse()
      .map((p) => `L${p.x},${p.l90}`)
      .join('');

    return {
      fcLine,
      b80: `${b80Top}${b80Bot}Z`,
      b90: `${b90Top}${b90Bot}Z`,
    };
  }

  function setActiveProduct(nextSlug: string) {
    if (nextSlug === currentProduct) return;
    const prevSlug = currentProduct;
    currentProduct = nextSlug;
    if (heroRoot) heroRoot.dataset.activeProduct = nextSlug;

    switchBtns.forEach((btn) => {
      const isMatch = btn.dataset.product === nextSlug;
      btn.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
    });

    heroPanels.forEach((panel) => {
      panel.hidden = panel.dataset.productPanel !== nextSlug;
    });
    mapPanels.forEach((panel) => {
      panel.hidden = panel.dataset.mapPanel !== nextSlug;
    });

    if (activeMorphTween) {
      activeMorphTween.kill();
      activeMorphTween = null;
    }

    const nextPanel = document.querySelector<HTMLElement>(`[data-product-panel="${nextSlug}"]`);
    const fromGeom = morphMap[prevSlug];
    const toGeom = morphMap[nextSlug];

    if (!nextPanel || !fromGeom || !toGeom || isReducedMotion()) {
      return;
    }

    const histPaths = nextPanel.querySelectorAll<SVGPathElement>(
      '.line-history, .line-history-casing'
    );
    const fcPaths = nextPanel.querySelectorAll<SVGPathElement>(
      '.line-forecast, .line-forecast-casing'
    );
    const band80El = nextPanel.querySelector<SVGPathElement>('.fan-band-80');
    const band90El = nextPanel.querySelector<SVGPathElement>('.fan-band-90');
    const fcGroup = nextPanel.querySelector<SVGGElement>('.hero-forecast-group');
    const peakDot = nextPanel.querySelector<SVGCircleElement>('.dot-peak');
    const anchorDot = nextPanel.querySelector<SVGCircleElement>('.dot-anchor');
    const fcDots = nextPanel.querySelectorAll<SVGCircleElement>('.dot-forecast');
    const annotations = nextPanel.querySelectorAll<SVGGElement>('.hero-annotation');
    const kpiCells = nextPanel.querySelectorAll<HTMLElement>('.kpi-cell, .honesty-strip');

    // Ensure stroke-dashoffset from initial draw is cleared on the target panel
    histPaths.forEach((p) => {
      p.style.strokeDasharray = 'none';
      p.style.strokeDashoffset = '0';
    });
    if (fcGroup) {
      gsap.set(fcGroup, { opacity: 1, scaleX: 1, clearProps: 'transform' });
    }

    // Morph path coordinates over 600ms (0.6s) and snap to exact D3 curves on completion
    const state = { t: 0 };
    activeMorphTween = gsap.to(state, {
      t: 1,
      duration: 0.6,
      ease: 'power2.inOut',
      onUpdate: () => {
        const dHist = buildInterpolatedHistoryPath(
          toGeom.x93,
          fromGeom.y93,
          toGeom.y93,
          toGeom.def93,
          state.t
        );
        histPaths.forEach((p) => p.setAttribute('d', dHist));

        const { fcLine, b80, b90 } = buildInterpolatedForecastPaths(
          fromGeom.fcBridge,
          toGeom.fcBridge,
          state.t
        );
        fcPaths.forEach((p) => p.setAttribute('d', fcLine));
        if (band80El) band80El.setAttribute('d', b80);
        if (band90El) band90El.setAttribute('d', b90);
      },
      onComplete: () => {
        histPaths.forEach((p) => p.setAttribute('d', toGeom.historyPath));
        fcPaths.forEach((p) => p.setAttribute('d', toGeom.forecastPath));
        if (band80El) band80El.setAttribute('d', toGeom.band80Path);
        if (band90El) band90El.setAttribute('d', toGeom.band90Path);
        activeMorphTween = null;
      },
    });

    // Smoothly translate dots from previous product coordinates to target coordinates
    if (peakDot) {
      gsap.fromTo(
        peakDot,
        { x: fromGeom.peak.x - toGeom.peak.x, y: fromGeom.peak.y - toGeom.peak.y },
        { x: 0, y: 0, duration: 0.6, ease: 'power2.inOut' }
      );
    }
    if (anchorDot) {
      gsap.fromTo(
        anchorDot,
        { x: fromGeom.lastObs.x - toGeom.lastObs.x, y: fromGeom.lastObs.y - toGeom.lastObs.y },
        { x: 0, y: 0, duration: 0.6, ease: 'power2.inOut' }
      );
    }
    fcDots.forEach((dot, i) => {
      const fDot = fromGeom.fcDots[i];
      const tDot = toGeom.fcDots[i];
      if (fDot && tDot) {
        gsap.fromTo(
          dot,
          { x: fDot.x - tDot.x, y: fDot.y - tDot.y, opacity: 1 },
          { x: 0, y: 0, opacity: 1, duration: 0.6, ease: 'power2.inOut' }
        );
      }
    });

    gsap.fromTo(
      annotations,
      { opacity: 0, y: 6 },
      { opacity: 1, y: 0, duration: 0.42, stagger: 0.05, ease: 'power2.out', overwrite: true }
    );
    gsap.fromTo(
      kpiCells,
      { opacity: 0, y: 6 },
      { opacity: 1, y: 0, duration: 0.38, stagger: 0.04, ease: 'power2.out', overwrite: true }
    );

    // Also stagger South-to-North dots on the newly revealed map panel if visible
    const activeMapPanel = document.querySelector<HTMLElement>(`[data-map-panel="${nextSlug}"]`);
    if (activeMapPanel) {
      const mapDots = activeMapPanel.querySelectorAll<SVGGElement>('.map-market-node');
      gsap.fromTo(
        mapDots,
        { opacity: 0, scale: 0.4, transformOrigin: '50% 50%' },
        {
          opacity: 1,
          scale: 1,
          duration: 0.35,
          stagger: { amount: 0.35, from: 'start' },
          ease: 'power2.out',
          overwrite: true,
        }
      );
    }
  }

  switchBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const slug = btn.dataset.product;
      if (slug) setActiveProduct(slug);
    });
  });

  // Dot map hover / tap / keyboard focus inspector + floating canvas tooltip
  const marketNodes = document.querySelectorAll<SVGGElement>('[data-market-node]');
  marketNodes.forEach((node) => {
    const activateNode = (showFloatingTooltip: boolean) => {
      const slug = node.dataset.marketNode;
      if (!slug) return;
      const inspector = document.querySelector<HTMLElement>(`[data-market-inspector="${slug}"]`);
      const mapWrap = document.querySelector<HTMLElement>(`[data-map-wrap="${slug}"]`);
      const tooltip = document.querySelector<HTMLElement>(`[data-map-tooltip="${slug}"]`);

      const siblingNodes = document.querySelectorAll<SVGGElement>(`[data-market-node="${slug}"]`);
      siblingNodes.forEach((sib) => sib.setAttribute('data-active', 'false'));
      node.setAttribute('data-active', 'true');

      if (inspector) {
        const setField = (field: string, value: string | undefined) => {
          const el = inspector.querySelector<HTMLElement>(`[data-field="${field}"]`);
          if (el && value) el.textContent = value;
        };
        setField('name', node.dataset.marketName);
        setField('department', node.dataset.department);
        setField('zone', node.dataset.zone);
        setField('coords', node.dataset.coords);
        setField('price', node.dataset.price);
        setField('diff', node.dataset.diff);
        setField('h3', node.dataset.h3);
        setField('mape', node.dataset.mape);
      }

      if (tooltip && mapWrap && showFloatingTooltip) {
        const setTt = (field: string, value: string | undefined) => {
          const el = tooltip.querySelector<HTMLElement>(`[data-tt-field="${field}"]`);
          if (el && value) el.textContent = value;
        };
        setTt('name', node.dataset.marketName);
        setTt('coords', node.dataset.coords);
        setTt('meta', `${node.dataset.department ?? ''} · ${node.dataset.zone ?? ''}`);
        setTt('price', node.dataset.price);
        setTt('diff', node.dataset.diff);
        setTt('h3', node.dataset.h3);

        tooltip.hidden = false;
        const cx = parseFloat(node.dataset.cx || '215');
        const cy = parseFloat(node.dataset.cy || '260');
        const wrapRect = mapWrap.getBoundingClientRect();
        const scaleX = wrapRect.width / 430;
        const scaleY = wrapRect.height / 520;
        const pxX = cx * scaleX;
        const pxY = cy * scaleY;

        const ttWidth = tooltip.offsetWidth || 228;
        const ttHeight = tooltip.offsetHeight || 96;
        const clampedX = Math.max(8, Math.min(wrapRect.width - ttWidth - 8, pxX - ttWidth / 2));
        const preferAboveY = pxY - ttHeight - 14;
        const finalY = preferAboveY >= 8 ? preferAboveY : Math.min(wrapRect.height - ttHeight - 8, pxY + 16);

        tooltip.style.transform = `translate3d(${Math.round(clampedX)}px, ${Math.round(finalY)}px, 0)`;
      }
    };

    const hideTooltip = () => {
      const slug = node.dataset.marketNode;
      if (!slug) return;
      const tooltip = document.querySelector<HTMLElement>(`[data-map-tooltip="${slug}"]`);
      if (tooltip) tooltip.hidden = true;
    };

    node.addEventListener('mouseenter', () => activateNode(true));
    node.addEventListener('mouseleave', hideTooltip);
    node.addEventListener('focus', () => activateNode(true));
    node.addEventListener('blur', hideTooltip);
    node.addEventListener('click', (e) => {
      e.stopPropagation();
      activateNode(true);
    });
    node.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        hideTooltip();
        node.blur();
      } else if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        activateNode(true);
      }
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document
        .querySelectorAll<HTMLElement>('[data-map-tooltip]')
        .forEach((tt) => (tt.hidden = true));
    }
  });

  // =========================================================================
  // Signature Motion & ScrollTrigger Reveals (Strictly respects reduced motion)
  // =========================================================================
  const mm = gsap.matchMedia();

  mm.add(
    {
      canAnimate: '(prefers-reduced-motion: no-preference)',
      reduceMotion: '(prefers-reduced-motion: reduce)',
    },
    (context) => {
      const { reduceMotion } = context.conditions as {
        canAnimate: boolean;
        reduceMotion: boolean;
      };

      if (reduceMotion) {
        // Immediately show final state with zero animation when prefers-reduced-motion: reduce
        gsap.set(
          '.line-history, .line-history-casing, .spark-line, .spark-line-casing',
          { clearProps: 'strokeDasharray,strokeDashoffset' }
        );
        gsap.set(
          '.hero-forecast-group, .hero-annotation, .dot-forecast, .spark-area, .dot-anchor, .map-market-node, .map-extremum-callout, [data-reveal="fade-up"]',
          { opacity: 1, clearProps: 'transform' }
        );
        return;
      }

      // 1. HERO SIGNATURE MOTION:
      // Price history line draws itself in 1.6s (stroke-dashoffset), then dashed forecast & 80%/90% fan bands extend
      const defaultHeroPanel = document.querySelector<HTMLElement>(
        `[data-product-panel="${currentProduct}"]`
      );
      if (defaultHeroPanel) {
        const histPaths = defaultHeroPanel.querySelectorAll<SVGPathElement>(
          '.line-history, .line-history-casing'
        );
        const fcGroup = defaultHeroPanel.querySelector<SVGGElement>('.hero-forecast-group');
        const fcDots = defaultHeroPanel.querySelectorAll<SVGCircleElement>('.dot-forecast');
        const peakAnnot = defaultHeroPanel.querySelector<SVGGElement>('.hero-peak-annotation');
        const anchorAnnot = defaultHeroPanel.querySelector<SVGGElement>('.hero-anchor-annotation');
        const fcAnnot = defaultHeroPanel.querySelector<SVGGElement>('.hero-forecast-annotations');

        histPaths.forEach((p) => {
          const totalLen = Math.ceil(p.getTotalLength() * 1.06 + 24);
          p.style.strokeDasharray = `${totalLen}`;
          p.style.strokeDashoffset = `${totalLen}`;
        });

        const asOfX = fcGroup?.dataset.asofX || '568';
        if (fcGroup) {
          gsap.set(fcGroup, { opacity: 0, scaleX: 0, svgOrigin: `${asOfX} 170` });
        }
        gsap.set([fcDots, peakAnnot, anchorAnnot, fcAnnot], { opacity: 0 });
        if (peakAnnot) gsap.set(peakAnnot, { y: 6 });
        if (anchorAnnot) gsap.set(anchorAnnot, { y: 6 });
        if (fcAnnot) gsap.set(fcAnnot, { x: -6 });

        const heroTl = gsap.timeline();
        heroTl
          .to(
            histPaths,
            {
              strokeDashoffset: 0,
              duration: 1.6,
              ease: 'power2.inOut',
              onComplete: () => {
                histPaths.forEach((p) => {
                  p.style.strokeDasharray = 'none';
                  p.style.strokeDashoffset = '0';
                });
              },
            },
            0
          )
          .to(
            peakAnnot,
            {
              opacity: 1,
              y: 0,
              duration: 0.38,
              ease: 'power2.out',
            },
            1.05
          )
          .to(
            anchorAnnot,
            {
              opacity: 1,
              y: 0,
              duration: 0.35,
              ease: 'power2.out',
            },
            1.48
          )
          .to(
            fcGroup,
            {
              opacity: 1,
              scaleX: 1,
              duration: 0.45,
              ease: 'power2.out',
            },
            1.58
          )
          .to(
            fcDots,
            {
              opacity: 1,
              duration: 0.3,
              stagger: 0.07,
              ease: 'power2.out',
            },
            1.68
          )
          .to(
            fcAnnot,
            {
              opacity: 1,
              x: 0,
              duration: 0.38,
              ease: 'power2.out',
            },
            1.75
          );
      }

      // 2. SECTION 2 SPARKLINE REVEALS (once on scroll)
      const storyCards = document.querySelectorAll<HTMLElement>('.stories-section .story-card');
      storyCards.forEach((card, idx) => {
        const sparkLines = card.querySelectorAll<SVGPathElement>(
          '.spark-line, .spark-line-casing'
        );
        const sparkArea = card.querySelector<SVGPathElement>('.spark-area');
        const sparkDot = card.querySelector<SVGCircleElement>('.dot-anchor');

        sparkLines.forEach((sl) => {
          const len = Math.ceil(sl.getTotalLength() * 1.05 + 12);
          sl.style.strokeDasharray = `${len}`;
          sl.style.strokeDashoffset = `${len}`;
        });
        if (sparkArea) gsap.set(sparkArea, { opacity: 0 });
        if (sparkDot) gsap.set(sparkDot, { opacity: 0, scale: 0, transformOrigin: '50% 50%' });

        const stTl = gsap.timeline({
          scrollTrigger: {
            trigger: card,
            start: 'top 85%',
            once: true,
          },
        });

        stTl
          .to(
            sparkLines,
            {
              strokeDashoffset: 0,
              duration: 0.9,
               delay: idx * 0.08,
              ease: 'power2.out',
            },
            0
          )
          .to(
            sparkArea,
            {
              opacity: 1,
              duration: 0.5,
              ease: 'power2.out',
            },
            0.35 + idx * 0.08
          )
          .to(
            sparkDot,
            {
              opacity: 1,
              scale: 1,
              duration: 0.3,
              ease: 'back.out(1.7)',
            },
            0.75 + idx * 0.08
          );
      });

      // 3. SECTION 3 PROGRESSIVE SOUTH-TO-NORTH MAP DOT REVEAL (once on scroll)
      const mapSection = document.getElementById('map-section-root');
      if (mapSection) {
        const activeMapPanel = mapSection.querySelector<HTMLElement>(
          `[data-map-panel="${currentProduct}"]`
        );
        if (activeMapPanel) {
          const dots = activeMapPanel.querySelectorAll<SVGGElement>('.map-market-node');
          const callouts = activeMapPanel.querySelectorAll<SVGGElement>('.map-extremum-callout');
          gsap.set(dots, { opacity: 0, scale: 0, transformOrigin: '50% 50%' });
          gsap.set(callouts, { opacity: 0, y: 6 });

          const mapTl = gsap.timeline({
            scrollTrigger: {
              trigger: mapSection,
              start: 'top 78%',
              once: true,
            },
          });

          mapTl
            .to(dots, {
              opacity: 1,
              scale: 1,
              duration: 0.38,
              stagger: { amount: 0.75, from: 'start' },
              ease: 'back.out(1.5)',
            })
            .to(
              callouts,
              {
                opacity: 1,
                y: 0,
                duration: 0.35,
                stagger: 0.1,
                ease: 'power2.out',
              },
              '-=0.2'
            );
        }
      }

      // 4. SUBTLE FADE-UP REVEALS (24px, ~400ms, once)
      const fadeElements = gsap.utils.toArray<HTMLElement>('[data-reveal="fade-up"]');
      ScrollTrigger.batch(fadeElements, {
        start: 'top 88%',
        once: true,
        onEnter: (batch) => {
          gsap.fromTo(
            batch,
            { opacity: 0, y: 24 },
            {
              opacity: 1,
              y: 0,
              duration: 0.4,
              stagger: 0.07,
              ease: 'power2.out',
              overwrite: true,
            }
          );
        },
      });
    }
  );
</script>

<style>
