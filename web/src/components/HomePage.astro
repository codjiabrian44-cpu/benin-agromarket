---
import {
  formatComputedStoryProse,
  formatDecimal,
  formatInt,
  formatModelName,
  formatSignedPct,
  formatYearMonth,
  formatZoneName,
  getDictionary,
  getLocalizedRoutes,
  type Locale,
  type ProductSlug,
} from '../i18n';
import {
  buildBeninDotMapGeometry,
  buildHeroChartGeometry,
  buildSparklineGeometry,
} from '../lib/charts';
import { getValidatedHomeData, type HistoryPoint, type HomeProductData } from '../lib/data';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const routes = getLocalizedRoutes(locale, import.meta.env.BASE_URL);
const homeData = getValidatedHomeData();

const productOrder: ProductSlug[] = ['maize_white', 'tomatoes', 'yam_white'];

/**
 * Guarantee full 93-month calendar grid (`2019-01-15..2026-09-15`) with explicit `is_observed: false, price: null`
 * on unobserved months so `d3.line().defined()` always breaks across missing months (`2020-02`, `2021-07`, etc.).
 */
function ensureFull93MonthHistory(rawHistory: HistoryPoint[]): HistoryPoint[] {
  const byDate = new Map<string, HistoryPoint>();
  for (const pt of rawHistory) {
    if (pt.date >= '2019-01-15' && pt.is_observed !== false && typeof pt.price === 'number') {
      byDate.set(pt.date, pt);
    }
  }
  const fullGrid: HistoryPoint[] = [];
  for (let yr = 2019; yr <= 2026; yr++) {
    const maxMo = yr === 2026 ? 9 : 12;
    for (let mo = 1; mo <= maxMo; mo++) {
      const mStr = String(mo).padStart(2, '0');
      const dStr = `${yr}-${mStr}-15`;
      const ymStr = `${yr}-${mStr}`;
      const existing = byDate.get(dStr);
      if (existing) {
        fullGrid.push({
          date: dStr,
          year_month: ymStr,
          price: existing.price,
          is_observed: true,
          is_outlier: Boolean(existing.is_outlier),
        });
      } else {
        fullGrid.push({
          date: dStr,
          year_month: ymStr,
          price: null,
          is_observed: false,
          is_outlier: false,
        });
      }
    }
  }
  return fullGrid;
}

/**
 * Build a plain-language one-sentence reliability note free of internal model IDs or technical jargon.
 */
function getPlainReliabilityNote(prod: HomeProductData, hKey: 'h1' | 'h2' | 'h3'): string {
  const relObj = prod.reliability_by_horizon[hKey];
  const accObj = prod.backtest_accuracy.by_horizon_test[hKey];
  const h = accObj.horizon_months;
  const champLabel = formatModelName(accObj.model_used, dict);
  const baseLabel = formatModelName(relObj.best_validation_baseline || accObj.best_baseline_val, dict);
  const bestTestLabel = formatModelName(relObj.best_holdout_candidate, dict);
  const maeStr = formatDecimal(accObj.mae, locale, 1);
  const mapeStr = formatDecimal(accObj.mape, locale, 1);
  const cov80Str = formatDecimal(relObj.holdout_coverage_80_pct ?? accObj.coverage_80, locale, 1);
  const skillStr = formatSignedPct(
    relObj.skill_vs_best_baseline_test_pct ?? accObj.skill_vs_best_baseline_pct,
    locale,
    1
  );
  const bestTestMaeStr = formatDecimal(relObj.best_holdout_candidate_mae, locale, 1);

  if (locale === 'fr') {
    if (relObj.status === 'baseline_retained_intervals_too_narrow') {
      return `Méthode retenue : ${champLabel} (erreur moyenne de ${maeStr} XOF/kg en test, soit ${mapeStr} %), mais la fourchette à 80 % est un peu étroite lors des variations rapides de prix (${cov80Str} % des prix observés en test tombent dans la fourchette au lieu de 80 %).`;
    }
    if (relObj.status === 'intervals_too_narrow') {
      return `Méthode retenue : ${champLabel} (erreur moyenne de ${maeStr} XOF/kg en test, soit ${mapeStr} %), mais la fourchette à 80 % n'a couvert que ${cov80Str} % des prix observés en test (cible : 80 %).`;
    }
    if (relObj.status === 'baseline_retained') {
      if (accObj.model_used === 'Naive_LastValue') {
        return `Méthode retenue : ${champLabel}. À ${h} mois, aucune méthode complexe ne fait mieux que le dernier prix connu (erreur moyenne en test : ${maeStr} XOF/kg, soit ${mapeStr} % ; fourchette à 80 % fiable à ${cov80Str} %).`;
      }
      return `Méthode retenue : ${champLabel}, choisie car elle égale les modèles complexes (erreur moyenne en test : ${maeStr} XOF/kg, soit ${mapeStr} % ; fourchette à 80 % fiable à ${cov80Str} %).`;
    }
    if ((relObj.skill_vs_best_baseline_test_pct ?? accObj.skill_vs_best_baseline_pct) >= 0) {
      return `Méthode retenue : ${champLabel}, avec des fourchettes fiables en test (erreur moyenne : ${maeStr} XOF/kg, soit ${mapeStr} %, gain de ${skillStr} face à « ${baseLabel} », fourchette à 80 % couvrant ${cov80Str} % des cas).`;
    }
    return `Méthode retenue : ${champLabel}, sélectionnée à l'entraînement avec une fourchette à 80 % fiable en test (${cov80Str} % des cas, erreur moyenne de ${maeStr} XOF/kg, soit ${mapeStr} %), bien que devancée sur les 12 mois de test par « ${bestTestLabel} » (${bestTestMaeStr} XOF/kg).`;
  }

  if (relObj.status === 'baseline_retained_intervals_too_narrow') {
    return `Selected method: ${champLabel} (average test error of ${maeStr} XOF/kg, or ${mapeStr}%), but the 80% interval is slightly narrow during rapid price swings (${cov80Str}% of observed test prices fall inside the interval instead of 80%).`;
  }
  if (relObj.status === 'intervals_too_narrow') {
    return `Selected method: ${champLabel} (average test error of ${maeStr} XOF/kg, or ${mapeStr}%), but the 80% interval covered ${cov80Str}% of observed test prices (target: 80%).`;
  }
  if (relObj.status === 'baseline_retained') {
    if (accObj.model_used === 'Naive_LastValue') {
      return `Selected method: ${champLabel}. At ${h} month${h > 1 ? 's' : ''}, no complex model beats the last known price (average test error: ${maeStr} XOF/kg, or ${mapeStr}%; 80% interval calibrated at ${cov80Str}%).`;
    }
    return `Selected method: ${champLabel}, retained because it matches complex models (average test error: ${maeStr} XOF/kg, or ${mapeStr}%; 80% interval calibrated at ${cov80Str}%).`;
  }
  if ((relObj.skill_vs_best_baseline_test_pct ?? accObj.skill_vs_best_baseline_pct) >= 0) {
    return `Selected method: ${champLabel}, with calibrated test intervals (average error: ${maeStr} XOF/kg, or ${mapeStr}%, ${skillStr} gain over "${baseLabel}", 80% interval covering ${cov80Str}% of cases).`;
  }
  return `Selected method: ${champLabel}, chosen in training with a reliable 80% test interval (${cov80Str}% coverage, average error ${maeStr} XOF/kg, or ${mapeStr}%), though trailed on the 12 test months by "${bestTestLabel}" (${bestTestMaeStr} XOF/kg).`;
}

// Pre-compute D3 SVG geometries for all 3 products at build time
const productViews = productOrder.map((slug) => {
  const prod = homeData.products[slug];
  const fullHistory93 = ensureFull93MonthHistory(prod.dantokpa.history);
  const heroGeom = buildHeroChartGeometry(fullHistory93, prod.dantokpa.forecasts, 760, 280);
  const sparkGeom = buildSparklineGeometry(prod.latest_national_stats.sparkline_36m, 300, 68);
  const mapGeom = buildBeninDotMapGeometry(
    prod.tier1_markets_map,
    slug,
    dict.mapLatBands,
    430,
    520
  );
  const fcH1 = prod.dantokpa.forecasts.find((f) => f.horizon_months === 1)!;
  const fcH2 = prod.dantokpa.forecasts.find((f) => f.horizon_months === 2)!;
  const fcH3 = prod.dantokpa.forecasts.find((f) => f.horizon_months === 3)!;
  const relH1 = prod.reliability_by_horizon.h1;
  const relH2 = prod.reliability_by_horizon.h2;
  const relH3 = prod.reliability_by_horizon.h3;
  const testH3 = prod.backtest_accuracy.by_horizon_test.h3;

  const peakMonthName =
    dict.months[String(prod.seasonality.peak_month_num) as keyof typeof dict.months];
  const troughMonthName =
    dict.months[String(prod.seasonality.trough_month_num) as keyof typeof dict.months];
  const peakToTroughRatio =
    prod.seasonality.peak_to_trough_ratio ??
    Math.round((prod.seasonality.peak_index / prod.seasonality.trough_index) * 100) / 100;

  const computedStoryProse = formatComputedStoryProse(
    prod.tier1_markets_count,
    troughMonthName,
    peakMonthName,
    formatDecimal(peakToTroughRatio, locale, 2),
    dict
  );

  // Last 12 calendar months + 3 forecast months for the accessible Dantokpa table drawer
  const recentHistory12 = fullHistory93.slice(-12);
  const plainNoteH3 = getPlainReliabilityNote(prod, 'h3');

  return {
    slug,
    prod,
    heroGeom,
    sparkGeom,
    mapGeom,
    fcH1,
    fcH2,
    fcH3,
    relH1,
    relH2,
    relH3,
    testH3,
    peakMonthName,
    troughMonthName,
    peakToTroughRatio,
    computedStoryProse,
    recentHistory12,
    plainNoteH3,
  };
});
---

<!-- =======================================================================
     1. HERO: Editorial Thesis + Product Chips + Dantokpa Chart & 4 Key Figures
     ======================================================================= -->
<section class="section-block hero-section" data-active-product="maize_white" id="hero-root">
  <div class="container">
    <div class="grid-12 hero-grid">
      <!-- Left Column (Cols 1-5): Headline, Subtitle, Product Chips, CTAs -->
      <div class="hero-copy-col">
        <p class="hero-kicker">{dict.home.hero.kicker}</p>
        <h1 class="hero-title">{dict.home.hero.title}</h1>
        <p class="hero-subtitle">{dict.home.hero.subtitle}</p>

        <div class="hero-selector-block">
          <span class="selector-label" id="hero-product-selector-label">
            {dict.home.hero.productSelectorLabel}
          </span>
          <div class="chip-group" role="group" aria-labelledby="hero-product-selector-label">
            {
              productOrder.map((slug, idx) => (
                <button
                  type="button"
                  class="product-chip"
                  data-product={slug}
                  data-role="product-switch"
                  aria-pressed={idx === 0 ? 'true' : 'false'}
                >
                  <span class="chip-swatch" aria-hidden="true" />
                  <span>{dict.products[slug].chip}</span>
                </button>
              ))
            }
          </div>
        </div>

        <div class="btn-row">
          <a href={routes.explorer} class="btn btn-primary">
            {dict.home.hero.ctaExplorer}
          </a>
          <a href={routes.forecast} class="btn btn-secondary">
            {dict.home.hero.ctaForecast}
          </a>
        </div>
      </div>

      <!-- Right Column (Cols 6-12): Dantokpa Market Price History + 3-Month Forecast -->
      <div class="hero-chart-col">
        {
          productViews.map((view, idx) => {
            const { slug, prod, heroGeom, fcH3, relH3, recentHistory12, plainNoteH3 } = view;
            const isDefault = idx === 0;
            const relLabel =
              dict.reliability[relH3.status as keyof typeof dict.reliability] ?? relH3.status;
            const modelH3Plain = formatModelName(fcH3.model_used, dict);

            return (
              <article
                class="ledger-card hero-chart-panel"
                data-product-panel={slug}
                hidden={!isDefault}
                aria-label={`${dict.home.hero.chartTitlePrefix} ${dict.products[slug].full}`}
              >
                <header class="chart-card-header">
                  <div>
                    <div class="chart-title-row">
                      <span class={`product-pill pill-${slug}`}>{dict.products[slug].chip}</span>
                      <h2 class="chart-card-title">
                        {dict.home.hero.chartTitlePrefix} {dict.products[slug].full}
                      </h2>
                    </div>
                    <p class="chart-card-subtitle">{dict.home.hero.chartSubtitle}</p>
                  </div>
                  <p class="unit-badge tabular-nums">{dict.units.nominalRetailNotice}</p>
                </header>

                <!-- Custom D3 SVG Chart (viewBox="0 0 760 280" so chart + 4 KPIs fit above 900px fold) -->
                <div class="svg-chart-wrap">
                  <svg
                    viewBox={`0 0 ${heroGeom.width} ${heroGeom.height}`}
                    class="hero-svg"
                    role="img"
                    aria-label={`${dict.home.hero.chartTitlePrefix} ${dict.products[slug].full} (2019–2026)`}
                  >
                    <title>
                      {dict.home.hero.chartTitlePrefix} {dict.products[slug].full} (
                      {dict.units.xofPerKg})
                    </title>

                    <!-- Shaded 3-Month Forecast Zone Backdrop -->
                    <rect
                      x={heroGeom.asOfX}
                      y={heroGeom.margin.top}
                      width={heroGeom.forecastZoneWidth}
                      height={heroGeom.height - heroGeom.margin.top - heroGeom.margin.bottom}
                      class="forecast-zone-bg"
                    />

                    <!-- Horizontal Y Gridlines & Labels -->
                    {heroGeom.yTicks.map((t) => (
                      <g class="axis-tick">
                        <line
                          x1={heroGeom.margin.left}
                          x2={heroGeom.width - heroGeom.margin.right}
                          y1={t.y}
                          y2={t.y}
                          class="grid-line"
                        />
                        <text
                          x={heroGeom.margin.left - 8}
                          y={t.y + 4}
                          text-anchor="end"
                          class="axis-text tabular-nums"
                        >
                          {formatInt(t.value, locale)}
                        </text>
                      </g>
                    ))}

                    <!-- Vertical X Year Ticks -->
                    {heroGeom.xTicks.map((xt) => (
                      <g class="axis-tick">
                        <line
                          x1={xt.x}
                          x2={xt.x}
                          y1={heroGeom.height - heroGeom.margin.bottom}
                          y2={heroGeom.height - heroGeom.margin.bottom + 5}
                          class="tick-mark"
                        />
                        <text
                          x={xt.x}
                          y={heroGeom.height - 8}
                          text-anchor="middle"
                          class="axis-text tabular-nums"
                        >
                          {xt.year}
                        </text>
                      </g>
                    ))}

                    <!-- As-of vertical divider line (sept. 2026) -->
                    <line
                      x1={heroGeom.asOfX}
                      x2={heroGeom.asOfX}
                      y1={heroGeom.margin.top}
                      y2={heroGeom.height - heroGeom.margin.bottom}
                      class="asof-line"
                    />
                    <text
                      x={heroGeom.asOfX - 6}
                      y={heroGeom.margin.top + 12}
                      text-anchor="end"
                      class="asof-label tabular-nums"
                    >
                      {dict.home.hero.chartAsOfMarker}
                    </text>
                    <text
                      x={heroGeom.asOfX + heroGeom.forecastZoneWidth / 2}
                      y={heroGeom.margin.top + 12}
                      text-anchor="middle"
                      class="forecast-zone-label tabular-nums"
                    >
                      {dict.home.hero.chartHorizonMarker}
                    </text>

                    <!-- 90% and 80% Forecast Uncertainty Fan Bands -->
                    <path d={heroGeom.band90Path} class={`fan-band-90 band-${slug}`} />
                    <path d={heroGeom.band80Path} class={`fan-band-80 band-${slug}`} />

                    <!-- Historical Observed Trajectory (breaks at unobserved months via d3.line().defined()) -->
                    <path d={heroGeom.historyPath} class={`line-history stroke-${slug}`} />

                    <!-- 3-Month Dashed Forecast Path (oct.–déc. 2026) -->
                    <path d={heroGeom.forecastPath} class={`line-forecast stroke-${slug}`} />

                    <!-- Last Observed Anchor Dot -->
                    <circle
                      cx={heroGeom.lastObsPoint.x}
                      cy={heroGeom.lastObsPoint.y}
                      r="4.5"
                      class={`dot-anchor fill-${slug}`}
                    />

                    <!-- Forecast Horizon Dots (1, 2, 3 months) -->
                    {heroGeom.forecastPoints.map((fp) => (
                      <circle
                        cx={fp.x}
                        cy={fp.y}
                        r="3.5"
                        class={`dot-forecast stroke-${slug}`}
                      />
                    ))}
                  </svg>
                </div>

                <!-- Legend Row -->
                <div class="chart-legend">
                  <span class="legend-item">
                    <span class={`legend-line-swatch stroke-bg-${slug}`} />
                    {dict.home.hero.legendObserved}
                  </span>
                  <span class="legend-item">
                    <span class={`legend-dash-swatch stroke-bg-${slug}`} />
                    {dict.home.hero.legendForecast}
                  </span>
                  <span class="legend-item">
                    <span class={`legend-band80-swatch band-bg-${slug}`} />
                    {dict.home.hero.legendBand80}
                  </span>
                  <span class="legend-item">
                    <span class={`legend-band90-swatch band-bg-${slug}`} />
                    {dict.home.hero.legendBand90}
                  </span>
                </div>

                <!-- Compact 4-Column Key Figures Row UNDER the SVG Chart -->
                <div class="kpi-strip tabular-nums">
                  <div class="kpi-cell">
                    <span class="kpi-label">{dict.home.hero.latestObservedLabel}</span>
                    <strong class="kpi-value nowrap">
                      {formatDecimal(prod.dantokpa.last_observed_price, locale, 1)}{' '}
                      <small class="nowrap">{dict.units.xofPerKg}</small>
                    </strong>
                  </div>
                  <div class="kpi-cell">
                    <span class="kpi-label">{dict.home.hero.forecastH3Label}</span>
                    <strong class="kpi-value">
                      <span class="nowrap">
                        {formatDecimal(fcH3.point_forecast, locale, 1)}{' '}
                        <small class="nowrap">{dict.units.xofPerKg}</small>
                      </span>{' '}
                      <span class="kpi-delta nowrap">
                        ({formatSignedPct(fcH3.change_vs_last_pct, locale, 1)})
                      </span>
                    </strong>
                  </div>
                  <div class="kpi-cell">
                    <span class="kpi-label">{dict.home.hero.interval80Label}</span>
                    <strong class="kpi-value nowrap">
                      [{formatInt(fcH3.low_80, locale)}, {formatInt(fcH3.high_80, locale)}]{' '}
                      <small class="nowrap">{dict.units.xofPerKg}</small>
                    </strong>
                  </div>
                  <div class="kpi-cell">
                    <span class="kpi-label">{dict.home.hero.modelUsedLabel}</span>
                    <strong class="kpi-value kpi-method">{modelH3Plain}</strong>
                  </div>
                </div>

                <!-- Honesty & Reliability Strip -->
                <div class="honesty-strip">
                  <div class="honesty-strip-top">
                    <span class="reliability-badge" data-status={relH3.status}>
                      {relLabel}
                    </span>
                    <span class="asof-meta tabular-nums">
                      {dict.home.hero.asOfLabel} :{' '}
                      <strong>{dict.home.hero.asOfDateFormatted}</strong>
                    </span>
                  </div>
                  <p class="honesty-note">{plainNoteH3}</p>
                </div>

                <!-- Accessible Data Table Drawer -->
                <details class="data-drawer">
                  <summary>{dict.home.hero.tableToggle}</summary>
                  <div class="table-scroll">
                    <table class="ledger-table">
                      <thead>
                        <tr>
                          <th>{dict.home.hero.tableDate}</th>
                          <th>{dict.home.hero.tableStatus}</th>
                          <th class="num">{dict.home.hero.tablePrice}</th>
                          <th class="num">{dict.home.hero.tableInterval80}</th>
                          <th class="num">{dict.home.hero.tableInterval90}</th>
                        </tr>
                      </thead>
                      <tbody>
                        {recentHistory12.map((pt) => (
                          <tr>
                            <td>{formatYearMonth(pt.date, dict)}</td>
                            <td>
                              {pt.is_observed !== false && pt.price !== null
                                ? dict.home.hero.statusObserved
                                : dict.home.hero.statusUnobserved}
                            </td>
                            <td class="num">
                              {pt.is_observed !== false && pt.price !== null
                                ? formatDecimal(pt.price, locale, 1)
                                : '—'}
                            </td>
                            <td class="num">—</td>
                            <td class="num">—</td>
                          </tr>
                        ))}
                        {prod.dantokpa.forecasts.map((fc) => {
                          const horizonLabel = dict.home.hero.horizonAtMonths.replace(
                            '{h}',
                            String(fc.horizon_months)
                          );
                          const fcRelLabel =
                            dict.reliability[fc.reliability as keyof typeof dict.reliability] ??
                            fc.reliability;
                          return (
                            <tr class="forecast-row">
                              <td>
                                {formatYearMonth(fc.target_date, dict)} ({horizonLabel})
                              </td>
                              <td>
                                <strong>{dict.home.hero.statusForecast}</strong> ·{' '}
                                {formatModelName(fc.model_used, dict)} ({fcRelLabel})
                              </td>
                              <td class="num">
                                <strong>{formatDecimal(fc.point_forecast, locale, 1)}</strong>
                              </td>
                              <td class="num">
                                [{formatDecimal(fc.low_80, locale, 1)},{' '}
                                {formatDecimal(fc.high_80, locale, 1)}]
                              </td>
                              <td class="num">
                                [{formatDecimal(fc.low_90, locale, 1)},{' '}
                                {formatDecimal(fc.high_90, locale, 1)}]
                              </td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                </details>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<!-- =======================================================================
     2. SECTION: "Trois produits, trois histoires" (Aligned Product Cards)
     ======================================================================= -->
<section class="section-block" aria-labelledby="stories-heading">
  <div class="container">
    <header class="section-header">
      <h2 class="section-title" id="stories-heading">{dict.home.stories.title}</h2>
      <p class="section-subtitle">{dict.home.stories.subtitle}</p>
    </header>

    <div class="grid-12 stories-grid stories-subgrid">
      {
        productViews.map(
          ({ slug, prod, sparkGeom, peakMonthName, troughMonthName, computedStoryProse }) => (
            <article class={`story-card card-accent-${slug}`}>
              <header class="story-card-header">
                <div class="story-card-title-row">
                  <span class={`product-pill pill-${slug}`}>{dict.products[slug].chip}</span>
                  <span
                    class="story-market-count tabular-nums"
                    title={dict.units.marketsDefinitionNote}
                  >
                    {prod.tier1_markets_count} {dict.units.marketsCount} ·{' '}
                    {formatInt(prod.observed_market_months, locale)} {dict.units.obsMonthsCount}
                  </span>
                </div>
                <h3 class="story-card-title">{dict.products[slug].full}</h3>
                <p class="story-card-prose">{computedStoryProse}</p>
              </header>

              <!-- 36-Month Tracked-Market Median Sparkline (D3 SVG) with Independent Vertical Scale Note -->
              <div class="sparkline-box">
                <div class="sparkline-meta tabular-nums">
                  <span>{dict.home.stories.sparklineCaption}</span>
                  <span class="sparkline-range nowrap">
                    min {formatInt(sparkGeom.minVal, locale)} – max{' '}
                    {formatInt(sparkGeom.maxVal, locale)} {dict.units.xofPerKg}
                  </span>
                </div>
                <svg
                  viewBox="0 0 300 68"
                  class="sparkline-svg"
                  role="img"
                  aria-label={`${dict.home.stories.sparklineCaption} — ${dict.products[slug].full}`}
                >
                  <path d={sparkGeom.areaPath} class={`spark-area band-${slug}`} />
                  <path d={sparkGeom.linePath} class={`spark-line stroke-${slug}`} />
                  <circle
                    cx={sparkGeom.lastX}
                    cy={sparkGeom.lastY}
                    r="4"
                    class={`dot-anchor fill-${slug}`}
                  />
                </svg>
                <p class="sparkline-scale-note">{dict.home.stories.sparklineScaleNote}</p>
              </div>

              <!-- Data-Computed Seasonal & Price Stats -->
              <dl class="story-stats-grid tabular-nums">
                <div class="story-stat-item">
                  <dt>{dict.home.stories.latestMedianLabel}</dt>
                  <dd>
                    <strong class="nowrap">
                      {formatDecimal(prod.latest_national_stats.median_price, locale, 1)}{' '}
                      {dict.units.xofPerKg}
                    </strong>
                  </dd>
