---
import {
  formatDecimal,
  formatInt,
  formatPct,
  formatSignedPct,
  formatYearMonth,
  formatZoneName,
  getDictionary,
  getLocalizedRoutes,
  type Locale,
  type ProductSlug,
} from '../i18n';
import {
  buildExplorerChartGeometry,
  buildSeasonalityChartGeometry,
} from '../lib/charts';
import {
  alignMedianSeries93,
  ensureFull93MonthHistory,
  getValidatedProductData,
} from '../lib/data';
import {
  findMatchingZoneSeasonality,
  groupMarketsByDepartment,
  resolveMarketSeries,
} from '../lib/marketClient';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const baseUrl = import.meta.env.BASE_URL;
const cleanBase = baseUrl === '/' ? '' : baseUrl.replace(/\/$/, '');
const routes = getLocalizedRoutes(locale, baseUrl);
const productOrder: ProductSlug[] = ['maize_white', 'tomatoes', 'yam_white'];

// Build-time default state: maize_white + Dantokpa (all 2019-2026, median off)
const defaultSlug: ProductSlug = 'maize_white';
const defaultPayload = getValidatedProductData(defaultSlug);
const defaultMarket = resolveMarketSeries(defaultPayload.series, 'Dantokpa');
const deptGroups = groupMarketsByDepartment(defaultPayload.series);

const defaultHistory93 = ensureFull93MonthHistory(defaultMarket.history_calendar_2019_2026 ?? defaultMarket.history);
const defaultMedian93 = alignMedianSeries93(defaultPayload.national_median_series);
const defaultChart = buildExplorerChartGeometry(defaultHistory93, defaultMedian93, 'all', false, 860, 330);

const defaultZoneSeasonality = findMatchingZoneSeasonality(
  defaultPayload.seasonality_by_zone,
  defaultMarket.agro_zone
);
const defaultSeasonChart = buildSeasonalityChartGeometry(defaultZoneSeasonality.monthly_indices, 560, 220);

const latestMedianVal =
  defaultPayload.product.latest_national_stats.median_price ??
  defaultMedian93[defaultMedian93.length - 1]?.price ??
  0;
const spreadPct =
  latestMedianVal > 0
    ? ((defaultMarket.last_observed_price - latestMedianVal) / latestMedianVal) * 100
    : 0;

// Find peak & trough months for the default zone seasonality
let troughBar = defaultSeasonChart.bars[0];
let peakBar = defaultSeasonChart.bars[0];
for (const b of defaultSeasonChart.bars) {
  if (b.isTrough) troughBar = b;
  if (b.isPeak) peakBar = b;
}
const troughMonthName = dict.months[String(troughBar.monthNum) as keyof typeof dict.months];
const peakMonthName = dict.months[String(peakBar.monthNum) as keyof typeof dict.months];
const amplitudePct =
  troughBar.index > 0 ? ((peakBar.index - troughBar.index) / troughBar.index) * 100 : 0;

const clientConfig = {
  locale,
  baseUrl: cleanBase,
  forecastRoute: routes.forecast,
  months: dict.months,
  monthsShort: dict.monthsShort,
  products: dict.products,
  zones: dict.zones,
  units: dict.units,
  i18n: dict.explorer,
};
---

<div
  id="explorer-root"
  data-active-product={defaultSlug}
  data-config={JSON.stringify(clientConfig)}
>
  <section class="subpage-hero">
    <div class="container">
      <p class="subpage-kicker">{dict.explorer.kicker}</p>
      <h1 class="subpage-title">{dict.explorer.title}</h1>
      <p class="subpage-subtitle">{dict.explorer.subtitle}</p>
    </div>
  </section>

  <!-- Product Chips + Searchable Market Picker -->
  <section class="controls-band" aria-label={dict.explorer.productLabel}>
    <div class="container">
      <div class="controls-grid">
        <div>
          <span class="control-group-label" id="explorer-product-label">
            {dict.explorer.productLabel}
          </span>
          <div class="chip-group" role="group" aria-labelledby="explorer-product-label">
            {
              productOrder.map((slug) => (
                <button
                  type="button"
                  class="product-chip"
                  data-product={slug}
                  data-role="explorer-product"
                  aria-pressed={slug === defaultSlug ? 'true' : 'false'}
                >
                  <span class="chip-swatch" aria-hidden="true" />
                  <span>{dict.products[slug].chip}</span>
                </button>
              ))
            }
          </div>
        </div>

        <div class="market-picker" id="explorer-market-picker">
          <span class="control-group-label" id="explorer-market-label">
            {dict.explorer.marketLabel}
          </span>
          <button
            type="button"
            class="market-picker-trigger"
            id="market-picker-trigger"
            aria-expanded="false"
            aria-controls="market-picker-panel"
            aria-labelledby="explorer-market-label market-picker-trigger-name"
          >
            <span>
              <span id="market-picker-trigger-name">{defaultMarket.market}</span>{' '}
              <span class="market-picker-trigger-meta" id="market-picker-trigger-dept">
                ({defaultMarket.admin1})
              </span>
            </span>
            <span aria-hidden="true">▾</span>
          </button>

          <div class="market-picker-panel" id="market-picker-panel" hidden>
            <div class="market-picker-search-wrap">
              <label for="market-picker-search" class="sr-only">
                {dict.explorer.marketSearchPlaceholder}
              </label>
              <input
                type="search"
                id="market-picker-search"
                class="market-picker-search"
                placeholder={dict.explorer.marketSearchPlaceholder}
                autocomplete="off"
              />
            </div>
            <div
              class="market-picker-list"
              id="market-picker-list"
              role="listbox"
              aria-label={dict.explorer.marketLabel}
            >
              {
                deptGroups.map((grp) => (
                  <div class="market-dept-group" data-dept={grp.department}>
                    <div class="market-dept-title">{grp.department}</div>
                    {grp.markets.map((m) => (
                      <button
                        type="button"
                        class="market-option"
                        role="option"
                        data-market={m.market}
                        aria-selected={m.market === defaultMarket.market ? 'true' : 'false'}
                      >
                        <span>{m.market}</span>
                        <span class="market-option-price">
                          {formatInt(m.last_observed_price, locale)} {dict.units.xofPerKg}
                        </span>
                      </button>
                    ))}
                  </div>
                ))
              }
            </div>
            <p class="market-picker-empty" id="market-picker-empty" hidden>
              {dict.explorer.marketSearchEmpty}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Historical Price Chart + KPI Strip + Data Table -->
  <section class="section-block">
    <div class="container">
      <div class="chart-toolbar">
        <div class="range-group" role="group" aria-label={dict.explorer.rangeLabel}>
          <button type="button" class="range-btn" data-range="1y" aria-pressed="false">
            {dict.explorer.range1y}
          </button>
          <button type="button" class="range-btn" data-range="3y" aria-pressed="false">
            {dict.explorer.range3y}
          </button>
          <button type="button" class="range-btn" data-range="all" aria-pressed="true">
            {dict.explorer.rangeAll}
          </button>
        </div>

        <label class="median-toggle-label">
          <input type="checkbox" id="explorer-median-toggle" />
          <span>{dict.explorer.compareMedianLabel}</span>
        </label>
      </div>

      <div class="editorial-chart-card">
        <div class="chart-header-row">
          <div>
            <h2 class="chart-heading" id="explorer-chart-title">
              {defaultMarket.market} ({defaultMarket.admin1}) · {dict.products[defaultSlug].full}
            </h2>
            <p class="chart-unit-note">
              {dict.units.nominalRetailNotice} {dict.explorer.unobservedGapNote}
            </p>
          </div>
          <p class="chart-unit-note">{dict.explorer.crosshairHint}</p>
        </div>

        <div class="chart-svg-stage">
          <svg
            id="explorer-price-svg"
            class="chart-svg-focusable"
            viewBox={`0 0 ${defaultChart.width} ${defaultChart.height}`}
            tabindex="0"
            role="img"
            aria-label={`${defaultMarket.market} · ${dict.products[defaultSlug].full} · ${dict.explorer.crosshairHint}`}
          >
            <g id="exp-grid-y">
              {
                defaultChart.yTicks.map((t) => (
                  <g>
                    <line
                      x1={defaultChart.margin.left}
                      x2={defaultChart.width - defaultChart.margin.right}
                      y1={t.y}
                      y2={t.y}
                      stroke="#D9CDB8"
                      stroke-width="1"
                    />
                    <text
                      x={defaultChart.margin.left - 8}
                      y={t.y + 4}
                      text-anchor="end"
                      fill="#6F665A"
                      font-size="11.5"
                      class="tabular-nums"
                    >
                      {formatInt(t.value, locale)}
                    </text>
                  </g>
                ))
              }
            </g>

            <g id="exp-axis-x">
              {
                defaultChart.xTicks.map((t) => (
                  <g>
                    <line
                      x1={t.x}
                      x2={t.x}
                      y1={defaultChart.height - defaultChart.margin.bottom}
                      y2={defaultChart.height - defaultChart.margin.bottom + 5}
                      stroke="#6F665A"
                      stroke-width="1"
                    />
                    <text
                      x={t.x}
                      y={defaultChart.height - defaultChart.margin.bottom + 19}
                      text-anchor="middle"
                      fill="#6F665A"
                      font-size="11.5"
                      class="tabular-nums"
                    >
                      {String(t.year)}
                    </text>
                  </g>
                ))
              }
            </g>

            <path
              id="exp-median-path"
              d=""
              fill="none"
              stroke="#6F665A"
              stroke-width="2"
              stroke-dasharray="5 4"
              hidden
            />

            <path
              id="exp-history-path"
              d={defaultChart.historyPath}
              fill="none"
              stroke="var(--active-product-stroke)"
              stroke-width="2.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />

            <!-- Interactive Crosshair Overlay -->
            <g id="exp-crosshair-group" hidden style="display: none;">
              <line
                id="exp-crosshair-line"
                x1="0"
                x2="0"
                y1={defaultChart.margin.top}
                y2={defaultChart.height - defaultChart.margin.bottom}
                stroke="#1E1B16"
                stroke-width="1.25"
                stroke-dasharray="3 3"
              />
              <circle
                id="exp-crosshair-median-dot"
                cx="0"
                cy="0"
                r="4"
                fill="#6F665A"
                stroke="#FFFDF9"
                stroke-width="1.5"
                hidden
              />
              <circle
                id="exp-crosshair-dot"
                cx="0"
                cy="0"
                r="5.5"
                fill="var(--active-product-stroke)"
                stroke="#FFFDF9"
                stroke-width="2"
              />
            </g>

            <rect
              id="exp-hover-overlay"
              x={defaultChart.margin.left}
              y={defaultChart.margin.top}
              width={defaultChart.width - defaultChart.margin.left - defaultChart.margin.right}
              height={defaultChart.height - defaultChart.margin.top - defaultChart.margin.bottom}
              fill="transparent"
              style="cursor: crosshair;"
            />
          </svg>

          <div
            id="exp-tooltip"
            class="chart-crosshair-tooltip"
            hidden
          ></div>

          <div id="exp-live-region" class="sr-only" aria-live="polite"></div>
        </div>

        <div class="chart-legend-row">
          <span class="legend-item">
            <span class="legend-line-solid" aria-hidden="true"></span>
            <span id="exp-legend-market">{dict.explorer.selectedMarketSeriesLabel}</span>
          </span>
          <span class="legend-item" id="exp-legend-median-wrap" hidden>
            <span class="legend-line-dashed" aria-hidden="true"></span>
            <span>{dict.explorer.medianSeriesLabel}</span>
          </span>
        </div>
      </div>

      <!-- 4-Metric Summary Strip -->
      <div class="kpi-strip-4">
        <div class="kpi-ledger-cell">
          <span class="kpi-ledger-label">{dict.explorer.latestPriceLabel}</span>
          <strong class="kpi-ledger-value" id="exp-kpi-latest">
            {formatDecimal(defaultMarket.last_observed_price, locale, 1)} {dict.units.xofPerKg}
          </strong>
        </div>
        <div class="kpi-ledger-cell">
          <span class="kpi-ledger-label">{dict.explorer.coverageLabel}</span>
          <strong class="kpi-ledger-value" id="exp-kpi-coverage">
            {defaultMarket.obs_months_2019_2026} {dict.explorer.coverageOutOf}
          </strong>
          <span class="kpi-ledger-sub" id="exp-kpi-coverage-pct">
            ({formatPct(defaultMarket.completeness_2019_2026_pct, locale, 1)})
          </span>
        </div>
        <div class="kpi-ledger-cell">
          <span class="kpi-ledger-label">{dict.explorer.spreadVsMedianLabel}</span>
          <strong class="kpi-ledger-value" id="exp-kpi-spread">
            {formatSignedPct(spreadPct, locale, 1)}
          </strong>
          <span class="kpi-ledger-sub" id="exp-kpi-median-val">
            {dict.explorer.medianSeriesLabel} : {formatDecimal(latestMedianVal, locale, 1)} {dict.units.xofPerKg}
          </span>
        </div>
        <div class="kpi-ledger-cell">
          <span class="kpi-ledger-label">{dict.explorer.periodMinMaxLabel}</span>
          <strong class="kpi-ledger-value" id="exp-kpi-minmax">
            {defaultChart.minObserved !== null ? formatInt(defaultChart.minObserved, locale) : '—'} –{' '}
            {defaultChart.maxObserved !== null ? formatInt(defaultChart.maxObserved, locale) : '—'}{' '}
            {dict.units.xofPerKg}
          </strong>
        </div>
      </div>

      <!-- Accessible Data Table -->
      <details class="data-drawer" id="explorer-table-drawer">
        <summary>
          <span>{dict.explorer.tableToggle}</span>
          <span aria-hidden="true">▾</span>
        </summary>
        <div class="table-scroll">
          <table class="ledger-table">
            <thead>
              <tr>
                <th scope="col">{dict.explorer.colDate}</th>
                <th scope="col">{dict.explorer.colStatus}</th>
                <th scope="col" class="num">{dict.explorer.colMarketPrice}</th>
                <th scope="col" class="num">{dict.explorer.colMedianPrice}</th>
              </tr>
            </thead>
            <tbody id="explorer-table-body">
              {
                defaultChart.points
                  .slice()
                  .reverse()
                  .map((pt) => (
                    <tr>
                      <td>{formatYearMonth(pt.date, dict)}</td>
                      <td>
                        {pt.isObserved ? dict.explorer.statusObserved : dict.explorer.statusUnobserved}
                      </td>
                      <td class="num">
                        {pt.price !== null ? formatDecimal(pt.price, locale, 1) : '—'}
                      </td>
                      <td class="num">
                        {pt.medianPrice !== null ? formatDecimal(pt.medianPrice, locale, 1) : '—'}
                      </td>
                    </tr>
                  ))
              }
            </tbody>
          </table>
        </div>
      </details>
    </div>
  </section>

  <!-- Monthly Seasonality Section -->
  <section class="section-block">
    <div class="container">
      <div class="seasonality-grid">
        <div class="editorial-chart-card">
          <div class="chart-header-row">
            <div>
              <h2 class="chart-heading" id="exp-season-heading">
                {dict.explorer.seasonalityHeadingTemplate
                  .replace('{product}', dict.products[defaultSlug].short)
                  .replace('{n}', String(defaultZoneSeasonality.tier1_markets))
                  .replace('{zone}', formatZoneName(defaultZoneSeasonality.zone, dict))}
              </h2>
              <p class="chart-unit-note" id="exp-season-scope">
                {dict.explorer.seasonalityScopeTemplate
                  .replace('{zone}', formatZoneName(defaultZoneSeasonality.zone, dict))
                  .replace('{n}', String(defaultZoneSeasonality.tier1_markets))}
              </p>
            </div>
          </div>

          <svg
            id="explorer-season-svg"
            class="chart-svg-focusable"
            viewBox={`0 0 ${defaultSeasonChart.width} ${defaultSeasonChart.height}`}
            role="img"
            aria-label={dict.explorer.seasonalityHeading}
          >
            <g id="exp-season-grid">
              {
                defaultSeasonChart.yTicks.map((t) => (
                  <g>
                    <line
                      x1={defaultSeasonChart.margin.left}
                      x2={defaultSeasonChart.width - defaultSeasonChart.margin.right}
                      y1={t.y}
                      y2={t.y}
                      stroke="#D9CDB8"
                      stroke-width="1"
                    />
                    <text
                      x={defaultSeasonChart.margin.left - 8}
                      y={t.y + 4}
                      text-anchor="end"
                      fill="#6F665A"
                      font-size="11"
                      class="tabular-nums"
                    >
                      {String(t.value)}
                    </text>
                  </g>
                ))
              }
            </g>

            <line
              id="exp-season-ref100"
              x1={defaultSeasonChart.margin.left}
              x2={defaultSeasonChart.width - defaultSeasonChart.margin.right}
              y1={defaultSeasonChart.ref100Y}
              y2={defaultSeasonChart.ref100Y}
              stroke="#1E1B16"
              stroke-width="1.5"
              stroke-dasharray="4 3"
            />

            <g id="exp-season-bars">
              {
                defaultSeasonChart.bars.map((b) => {
                  const mLabel = dict.monthsShort[String(b.monthNum) as keyof typeof dict.monthsShort];
                  const fill = b.isPeak
                    ? 'var(--active-product-stroke)'
                    : b.isTrough
                      ? '#1E1B16'
                      : b.isAbove100
                        ? 'var(--active-product-color)'
                        : '#9A8F7E';
                  return (
                    <g>
                      <rect
                        x={b.x - defaultSeasonChart.barWidth / 2}
                        y={b.yTop}
                        width={defaultSeasonChart.barWidth}
                        height={b.barHeight}
                        fill={fill}
                        rx="2"
                      />
                      <text
                        x={b.x}
                        y={defaultSeasonChart.height - defaultSeasonChart.margin.bottom + 16}
                        text-anchor="middle"
                        fill="#1E1B16"
                        font-size="11"
                      >
                        {mLabel}
                      </text>
                    </g>
                  );
                })
              }
            </g>
          </svg>
        </div>

        <div>
          <div class="kpi-ledger-cell" style="margin-bottom: var(--space-3);">
            <span class="kpi-ledger-label">{dict.explorer.seasonalityTroughLabel}</span>
            <strong class="kpi-ledger-value" id="exp-season-trough">
              {troughMonthName} ({formatDecimal(troughBar.index, locale, 1)})
            </strong>
          </div>
          <div class="kpi-ledger-cell" style="margin-bottom: var(--space-3);">
            <span class="kpi-ledger-label">{dict.explorer.seasonalityPeakLabel}</span>
            <strong class="kpi-ledger-value" id="exp-season-peak">
              {peakMonthName} ({formatDecimal(peakBar.index, locale, 1)})
            </strong>
          </div>
          <div class="kpi-ledger-cell" style="margin-bottom: var(--space-4);">
            <span class="kpi-ledger-label">{dict.explorer.seasonalityAmplitudeLabel}</span>
            <strong class="kpi-ledger-value" id="exp-season-amp">
              {formatSignedPct(amplitudePct, locale, 1)}
            </strong>
            <span class="kpi-ledger-sub">{dict.units.seasonalIndexTooltip}</span>
          </div>

          <a
            id="exp-forecast-cta"
            href={`${routes.forecast}?product=${defaultSlug}&market=${encodeURIComponent(defaultMarket.market)}`}
            class="btn btn-primary"
          >
            {dict.explorer.viewForecastCta}
          </a>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  import {
    formatDecimal,
    formatInt,
    formatPct,
    formatSignedPct,
    formatYearMonth,
    formatZoneName,
    type ProductSlug,
  } from '../i18n';
  import {
    buildExplorerChartGeometry,
    buildSeasonalityChartGeometry,
    type ExplorerChartGeometry,
    type ExplorerRangePreset,
  } from '../lib/charts';
  import {
    alignMedianSeries93,
    ensureFull93MonthHistory,
    type ProductPayload,
  } from '../lib/data';
  import {
    canonicalizeExplorerUrl,
    findMatchingZoneSeasonality,
    groupMarketsByDepartment,
    loadProductPayload,
    parseUrlState,
    resolveMarketSeries,
  } from '../lib/marketClient';

  const root = document.getElementById('explorer-root');
  if (root) {
    const cfg = JSON.parse(root.getAttribute('data-config') || '{}');
    const locale = cfg.locale as 'fr' | 'en';
    const baseUrl = cfg.baseUrl as string;
    const dictLike = {
      months: cfg.months,
      monthsShort: cfg.monthsShort,
      zones: cfg.zones,
    } as any;

    const urlState = parseUrlState();
    const state: {
      product: ProductSlug;
      market: string;
      range: ExplorerRangePreset;
      median: boolean;
    } = {
      product: urlState.product,
      market: urlState.market || 'Dantokpa',
      range: urlState.range,
      median: urlState.median,
    };

    let currentPayload: ProductPayload | null = null;
    let currentChartGeom: ExplorerChartGeometry | null = null;
    let activePointIdx = -1;

    const productBtns = root.querySelectorAll<HTMLButtonElement>('[data-role="explorer-product"]');
    const rangeBtns = root.querySelectorAll<HTMLButtonElement>('[data-range]');
    const medianToggle = document.getElementById('explorer-median-toggle') as HTMLInputElement;
    const pickerTrigger = document.getElementById('market-picker-trigger') as HTMLButtonElement;
    const pickerPanel = document.getElementById('market-picker-panel') as HTMLDivElement;
    const pickerSearch = document.getElementById('market-picker-search') as HTMLInputElement;
    const pickerList = document.getElementById('market-picker-list') as HTMLDivElement;
    const pickerEmpty = document.getElementById('market-picker-empty') as HTMLParagraphElement;
    const triggerName = document.getElementById('market-picker-trigger-name')!;
    const triggerDept = document.getElementById('market-picker-trigger-dept')!;

    const chartSvg = document.getElementById('explorer-price-svg') as unknown as SVGSVGElement;
    const gridYEl = document.getElementById('exp-grid-y')!;
    const axisXEl = document.getElementById('exp-axis-x')!;
    const historyPathEl = document.getElementById('exp-history-path')!;
    const medianPathEl = document.getElementById('exp-median-path')!;
    const legendMedianWrap = document.getElementById('exp-legend-median-wrap')!;
    const hoverOverlay = document.getElementById('exp-hover-overlay')!;
    const crosshairGroup = document.getElementById('exp-crosshair-group')!;
    const crosshairLine = document.getElementById('exp-crosshair-line')!;
    const crosshairDot = document.getElementById('exp-crosshair-dot')!;
    const crosshairMedianDot = document.getElementById('exp-crosshair-median-dot')!;
    const tooltipEl = document.getElementById('exp-tooltip')!;
    const liveRegionEl = document.getElementById('exp-live-region')!;

    const SVG_NS = 'http://www.w3.org/2000/svg';

    function syncControlButtons() {
      root?.setAttribute('data-active-product', state.product);
      productBtns.forEach((btn) => {
        btn.setAttribute('aria-pressed', btn.dataset.product === state.product ? 'true' : 'false');
      });
      rangeBtns.forEach((btn) => {
        btn.setAttribute('aria-pressed', btn.dataset.range === state.range ? 'true' : 'false');
      });
      if (medianToggle) medianToggle.checked = state.median;
    }

    function renderMarketDropdown(payload: ProductPayload, selectedMarketName: string) {
      const groups = groupMarketsByDepartment(payload.series);
      pickerList.innerHTML = '';
      for (const grp of groups) {
        const groupDiv = document.createElement('div');
        groupDiv.className = 'market-dept-group';
        groupDiv.setAttribute('data-dept', grp.department);

        const titleDiv = document.createElement('div');
        titleDiv.className = 'market-dept-title';
        titleDiv.textContent = grp.department;
        groupDiv.appendChild(titleDiv);

        for (const m of grp.markets) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'market-option';
          btn.setAttribute('role', 'option');
          btn.setAttribute('data-market', m.market);
          btn.setAttribute('aria-selected', m.market === selectedMarketName ? 'true' : 'false');

          const nameSpan = document.createElement('span');
          nameSpan.textContent = m.market;
          const priceSpan = document.createElement('span');
          priceSpan.className = 'market-option-price';
          priceSpan.textContent = `${formatInt(m.last_observed_price, locale)} ${cfg.units.xofPerKg}`;

          btn.appendChild(nameSpan);
          btn.appendChild(priceSpan);
          btn.addEventListener('click', () => {
            state.market = m.market;
            closePicker();
            renderAll();
          });
          groupDiv.appendChild(btn);
        }
        pickerList.appendChild(groupDiv);
      }
      filterMarketDropdown(pickerSearch.value);
    }

    function filterMarketDropdown(query: string) {
      const q = query.trim().toLowerCase();
      let visibleCount = 0;
      const groups = pickerList.querySelectorAll<HTMLElement>('.market-dept-group');
      groups.forEach((grp) => {
        const dept = (grp.getAttribute('data-dept') || '').toLowerCase();
        const deptMatch = q.length > 0 && dept.includes(q);
        let groupVisible = 0;
        grp.querySelectorAll<HTMLButtonElement>('.market-option').forEach((opt) => {
          const mName = (opt.getAttribute('data-market') || '').toLowerCase();
          const show = !q || deptMatch || mName.includes(q);
          opt.hidden = !show;
          if (show) {
            groupVisible++;
            visibleCount++;
          }
        });
        grp.hidden = groupVisible === 0;
      });
      pickerEmpty.hidden = visibleCount > 0;
    }

    function openPicker() {
      pickerPanel.hidden = false;
      pickerTrigger.setAttribute('aria-expanded', 'true');
      pickerSearch.focus();
    }

    function closePicker(returnFocus = false) {
      pickerPanel.hidden = true;
      pickerTrigger.setAttribute('aria-expanded', 'false');
      if (returnFocus) pickerTrigger.focus();
    }

    function updateCrosshair(idx: number, announce = false) {
      if (!currentChartGeom || idx < 0 || idx >= currentChartGeom.points.length) {
        crosshairGroup.setAttribute('hidden', '');
        crosshairGroup.style.display = 'none';
        tooltipEl.hidden = true;
        activePointIdx = -1;
        return;
      }
      activePointIdx = idx;
      const pt = currentChartGeom.points[idx];
      crosshairGroup.removeAttribute('hidden');
      crosshairGroup.style.display = '';
      crosshairLine.setAttribute('x1', String(pt.x));
      crosshairLine.setAttribute('x2', String(pt.x));

      if (pt.isObserved && pt.y !== null) {
        crosshairDot.removeAttribute('hidden');
        crosshairDot.style.display = '';
        crosshairDot.setAttribute('cx', String(pt.x));
        crosshairDot.setAttribute('cy', String(pt.y));
      } else {
        crosshairDot.setAttribute('hidden', '');
        crosshairDot.style.display = 'none';
      }

      if (state.median && pt.medianY !== null) {
        crosshairMedianDot.removeAttribute('hidden');
        crosshairMedianDot.style.display = '';
        crosshairMedianDot.setAttribute('cx', String(pt.x));
        crosshairMedianDot.setAttribute('cy', String(pt.medianY));
      } else {
        crosshairMedianDot.setAttribute('hidden', '');
        crosshairMedianDot.style.display = 'none';
      }

      const dateLabel = formatYearMonth(pt.date, dictLike);
      const priceStr =
        pt.isObserved && pt.price !== null
          ? `${formatDecimal(pt.price, locale, 1)} ${cfg.units.xofPerKg}`
          : cfg.i18n.statusUnobserved;

      let html = `<div><strong>${dateLabel}</strong></div><div>${state.market} : ${priceStr}</div>`;
      if (state.median) {
        const medStr =
          pt.medianPrice !== null
            ? `${formatDecimal(pt.medianPrice, locale, 1)} ${cfg.units.xofPerKg}`
            : '—';
        html += `<div>${cfg.i18n.medianSeriesLabel} : ${medStr}</div>`;
      }
      tooltipEl.innerHTML = html;
      tooltipEl.hidden = false;

      // Position tooltip left/right cleanly inside stage
      const pctX = (pt.x / currentChartGeom.width) * 100;
      if (pctX > 62) {
        tooltipEl.style.left = 'auto';
        tooltipEl.style.right = `${Math.max(4, 100 - pctX + 2)}%`;
      } else {
        tooltipEl.style.right = 'auto';
        tooltipEl.style.left = `${Math.max(8, pctX + 2)}%`;
      }

      if (announce) {
        const medAnnounce =
          state.median && pt.medianPrice !== null
            ? `, ${cfg.i18n.medianSeriesLabel} ${formatDecimal(pt.medianPrice, locale, 1)} ${cfg.units.xofPerKg}`
            : '';
        liveRegionEl.textContent = `${dateLabel} : ${priceStr}${medAnnounce}`;
      }
    }

    function renderAll() {
      if (!currentPayload) return;
      const mkt = resolveMarketSeries(currentPayload.series, state.market);
      state.market = mkt.market;

      syncControlButtons();
      canonicalizeExplorerUrl(locale, state);

      triggerName.textContent = mkt.market;
      triggerDept.textContent = `(${mkt.admin1})`;
      pickerList.querySelectorAll<HTMLButtonElement>('.market-option').forEach((opt) => {
        opt.setAttribute('aria-selected', opt.dataset.market === mkt.market ? 'true' : 'false');
      });

      const hist93 = ensureFull93MonthHistory(mkt.history_calendar_2019_2026 ?? mkt.history);
      const med93 = alignMedianSeries93(currentPayload.national_median_series);
      const geom = buildExplorerChartGeometry(hist93, med93, state.range, state.median, 860, 330);
      currentChartGeom = geom;

      document.getElementById('explorer-chart-title')!.textContent =
        `${mkt.market} (${mkt.admin1}) · ${cfg.products[state.product].full}`;
      chartSvg.setAttribute(
        'aria-label',
        `${mkt.market} · ${cfg.products[state.product].full} · ${cfg.i18n.crosshairHint}`
      );

      // Update Y grid
      gridYEl.innerHTML = '';
      for (const t of geom.yTicks) {
        const g = document.createElementNS(SVG_NS, 'g');
        const ln = document.createElementNS(SVG_NS, 'line');
        ln.setAttribute('x1', String(geom.margin.left));
        ln.setAttribute('x2', String(geom.width - geom.margin.right));
        ln.setAttribute('y1', String(t.y));
        ln.setAttribute('y2', String(t.y));
        ln.setAttribute('stroke', '#D9CDB8');
        ln.setAttribute('stroke-width', '1');
        const txt = document.createElementNS(SVG_NS, 'text');
        txt.setAttribute('x', String(geom.margin.left - 8));
        txt.setAttribute('y', String(t.y + 4));
        txt.setAttribute('text-anchor', 'end');
        txt.setAttribute('fill', '#6F665A');
        txt.setAttribute('font-size', '11.5');
        txt.setAttribute('class', 'tabular-nums');
        txt.textContent = formatInt(t.value, locale);
        g.appendChild(ln);
        g.appendChild(txt);
        gridYEl.appendChild(g);
      }

      // Update X ticks
      axisXEl.innerHTML = '';
      for (const t of geom.xTicks) {
        const g = document.createElementNS(SVG_NS, 'g');
        const ln = document.createElementNS(SVG_NS, 'line');
        ln.setAttribute('x1', String(t.x));
        ln.setAttribute('x2', String(t.x));
        ln.setAttribute('y1', String(geom.height - geom.margin.bottom));
        ln.setAttribute('y2', String(geom.height - geom.margin.bottom + 5));
        ln.setAttribute('stroke', '#6F665A');
        ln.setAttribute('stroke-width', '1');
        const txt = document.createElementNS(SVG_NS, 'text');
        txt.setAttribute('x', String(t.x));
        txt.setAttribute('y', String(geom.height - geom.margin.bottom + 19));
        txt.setAttribute('text-anchor', 'middle');
        txt.setAttribute('fill', '#6F665A');
        txt.setAttribute('font-size', '11.5');
        txt.setAttribute('class', 'tabular-nums');
        txt.textContent =
          state.range === '1y'
            ? `${cfg.monthsShort[String(t.monthNum)]} ${String(t.year).slice(-2)}`
            : state.range === '3y' && !t.isJan
              ? `${cfg.monthsShort[String(t.monthNum)]}`
              : String(t.year);
        g.appendChild(ln);
        g.appendChild(txt);
        axisXEl.appendChild(g);
      }

      historyPathEl.setAttribute('d', geom.historyPath);
      if (state.median && geom.medianPath) {
        medianPathEl.setAttribute('d', geom.medianPath);
        medianPathEl.removeAttribute('hidden');
        legendMedianWrap.hidden = false;
      } else {
        medianPathEl.setAttribute('hidden', '');
        legendMedianWrap.hidden = true;
      }
      updateCrosshair(-1);

      // KPIs
      const latestMed =
        currentPayload.product.latest_national_stats.median_price ??
        med93[med93.length - 1]?.price ??
        0;
      const spread = latestMed > 0 ? ((mkt.last_observed_price - latestMed) / latestMed) * 100 : 0;
      document.getElementById('exp-kpi-latest')!.textContent =
        `${formatDecimal(mkt.last_observed_price, locale, 1)} ${cfg.units.xofPerKg}`;
      document.getElementById('exp-kpi-coverage')!.textContent =
        `${mkt.obs_months_2019_2026} ${cfg.i18n.coverageOutOf}`;
      document.getElementById('exp-kpi-coverage-pct')!.textContent =
        `(${formatPct(mkt.completeness_2019_2026_pct, locale, 1)})`;
      document.getElementById('exp-kpi-spread')!.textContent = formatSignedPct(spread, locale, 1);
      document.getElementById('exp-kpi-median-val')!.textContent =
        `${cfg.i18n.medianSeriesLabel} : ${formatDecimal(latestMed, locale, 1)} ${cfg.units.xofPerKg}`;
      document.getElementById('exp-kpi-minmax')!.textContent =
        `${geom.minObserved !== null ? formatInt(geom.minObserved, locale) : '—'} – ${geom.maxObserved !== null ? formatInt(geom.maxObserved, locale) : '—'} ${cfg.units.xofPerKg}`;

      // Data Table
      const tbody = document.getElementById('explorer-table-body')!;
      tbody.innerHTML = '';
      for (const pt of [...geom.points].reverse()) {
        const tr = document.createElement('tr');
        tr.innerHTML = `<td>${formatYearMonth(pt.date, dictLike)}</td><td>${pt.isObserved ? cfg.i18n.statusObserved : cfg.i18n.statusUnobserved}</td><td class="num">${pt.price !== null ? formatDecimal(pt.price, locale, 1) : '—'}</td><td class="num">${pt.medianPrice !== null ? formatDecimal(pt.medianPrice, locale, 1) : '—'}</td>`;
        tbody.appendChild(tr);
      }

      // Seasonality
      const zoneItem = findMatchingZoneSeasonality(
        currentPayload.seasonality_by_zone,
        mkt.agro_zone
      );
      const sGeom = buildSeasonalityChartGeometry(zoneItem.monthly_indices, 560, 220);
      document.getElementById('exp-season-heading')!.textContent = cfg.i18n.seasonalityHeadingTemplate
        .replace('{product}', cfg.products[state.product].short)
        .replace('{n}', String(zoneItem.tier1_markets))
        .replace('{zone}', formatZoneName(zoneItem.zone, dictLike));
      document.getElementById('exp-season-scope')!.textContent = cfg.i18n.seasonalityScopeTemplate
        .replace('{zone}', formatZoneName(zoneItem.zone, dictLike))
        .replace('{n}', String(zoneItem.tier1_markets));
      document
        .getElementById('exp-season-ref100')!
        .setAttribute('y1', String(sGeom.ref100Y));
      document
        .getElementById('exp-season-ref100')!
        .setAttribute('y2', String(sGeom.ref100Y));

      const sGrid = document.getElementById('exp-season-grid')!;
      sGrid.innerHTML = '';
      for (const t of sGeom.yTicks) {
        const g = document.createElementNS(SVG_NS, 'g');
        const ln = document.createElementNS(SVG_NS, 'line');
        ln.setAttribute('x1', String(sGeom.margin.left));
        ln.setAttribute('x2', String(sGeom.width - sGeom.margin.right));
        ln.setAttribute('y1', String(t.y));
        ln.setAttribute('y2', String(t.y));
        ln.setAttribute('stroke', '#D9CDB8');
        ln.setAttribute('stroke-width', '1');
        const txt = document.createElementNS(SVG_NS, 'text');
        txt.setAttribute('x', String(sGeom.margin.left - 8));
        txt.setAttribute('y', String(t.y + 4));
        txt.setAttribute('text-anchor', 'end');
        txt.setAttribute('fill', '#6F665A');
        txt.setAttribute('font-size', '11');
        txt.setAttribute('class', 'tabular-nums');
        txt.textContent = String(t.value);
        g.appendChild(ln);
        g.appendChild(txt);
        sGrid.appendChild(g);
      }

      const sBars = document.getElementById('exp-season-bars')!;
      sBars.innerHTML = '';
      let tBar = sGeom.bars[0];
      let pBar = sGeom.bars[0];
      for (const b of sGeom.bars) {
        if (b.isTrough) tBar = b;
        if (b.isPeak) pBar = b;
        const g = document.createElementNS(SVG_NS, 'g');
        const rect = document.createElementNS(SVG_NS, 'rect');
        rect.setAttribute('x', String(b.x - sGeom.barWidth / 2));
        rect.setAttribute('y', String(b.yTop));
        rect.setAttribute('width', String(sGeom.barWidth));
        rect.setAttribute('height', String(b.barHeight));
        rect.setAttribute('rx', '2');
        rect.setAttribute(
          'fill',
          b.isPeak
            ? 'var(--active-product-stroke)'
            : b.isTrough
              ? '#1E1B16'
              : b.isAbove100
                ? 'var(--active-product-color)'
                : '#9A8F7E'
        );
        const txt = document.createElementNS(SVG_NS, 'text');
        txt.setAttribute('x', String(b.x));
        txt.setAttribute('y', String(sGeom.height - sGeom.margin.bottom + 16));
        txt.setAttribute('text-anchor', 'middle');
        txt.setAttribute('fill', '#1E1B16');
        txt.setAttribute('font-size', '11');
        txt.textContent = cfg.monthsShort[String(b.monthNum)];
        g.appendChild(rect);
        g.appendChild(txt);
        sBars.appendChild(g);
      }

      const tMonth = cfg.months[String(tBar.monthNum)];
      const pMonth = cfg.months[String(pBar.monthNum)];
      const amp = tBar.index > 0 ? ((pBar.index - tBar.index) / tBar.index) * 100 : 0;
      document.getElementById('exp-season-trough')!.textContent =
        `${tMonth} (${formatDecimal(tBar.index, locale, 1)})`;
      document.getElementById('exp-season-peak')!.textContent =
        `${pMonth} (${formatDecimal(pBar.index, locale, 1)})`;
      document.getElementById('exp-season-amp')!.textContent = formatSignedPct(amp, locale, 1);

      const fcCta = document.getElementById('exp-forecast-cta') as HTMLAnchorElement;
      fcCta.href = `${cfg.forecastRoute}?product=${state.product}&market=${encodeURIComponent(mkt.market)}`;
    }

    async function switchProduct(slug: ProductSlug) {
      state.product = slug;
      syncControlButtons();
      try {
        currentPayload = await loadProductPayload(baseUrl, slug);
        const resolved = resolveMarketSeries(currentPayload.series, state.market);
        state.market = resolved.market;
        renderMarketDropdown(currentPayload, resolved.market);
        renderAll();
      } catch (err) {
        console.error(err);
      }
    }

    productBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.dataset.product as ProductSlug;
        if (slug && slug !== state.product) switchProduct(slug);
      });
    });

    rangeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        state.range = (btn.dataset.range as ExplorerRangePreset) || 'all';
        renderAll();
      });
    });

    medianToggle?.addEventListener('change', () => {
      state.median = medianToggle.checked;
      renderAll();
    });

    pickerTrigger.addEventListener('click', () => {
      if (pickerPanel.hidden) openPicker();
      else closePicker();
    });

    pickerSearch.addEventListener('input', () => {
      filterMarketDropdown(pickerSearch.value);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !pickerPanel.hidden) {
        e.preventDefault();
        closePicker(true);
      }
    });

    document.addEventListener('click', (e) => {
      if (!pickerPanel.hidden && !document.getElementById('explorer-market-picker')?.contains(e.target as Node)) {
        closePicker();
      }
    });

    // Pointer & Keyboard Crosshair
    function findNearestPointIdx(clientX: number): number {
      if (!currentChartGeom) return -1;
      const rect = chartSvg.getBoundingClientRect();
      if (!rect.width) return -1;
      const svgX = ((clientX - rect.left) / rect.width) * currentChartGeom.width;
      let bestIdx = 0;
      let bestDist = Infinity;
      for (let i = 0; i < currentChartGeom.points.length; i++) {
        const dist = Math.abs(currentChartGeom.points[i].x - svgX);
        if (dist < bestDist) {
          bestDist = dist;
          bestIdx = i;
        }
      }
      return bestIdx;
    }

    hoverOverlay.addEventListener('pointermove', (e: PointerEvent) => {
      const idx = findNearestPointIdx(e.clientX);
      if (idx >= 0) updateCrosshair(idx, false);
    });

    hoverOverlay.addEventListener('pointerleave', () => {
      updateCrosshair(-1);
    });

    chartSvg.addEventListener('keydown', (e: KeyboardEvent) => {
      if (!currentChartGeom || !currentChartGeom.points.length) return;
      const maxIdx = currentChartGeom.points.length - 1;
      let nextIdx = activePointIdx;
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        nextIdx = activePointIdx < 0 ? 0 : Math.min(maxIdx, activePointIdx + 1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        nextIdx = activePointIdx < 0 ? maxIdx : Math.max(0, activePointIdx - 1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        nextIdx = 0;
      } else if (e.key === 'End') {
        e.preventDefault();
        nextIdx = maxIdx;
      } else if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        nextIdx = activePointIdx < 0 ? maxIdx : activePointIdx;
      } else {
        return;
      }
      updateCrosshair(nextIdx, true);
    });

    chartSvg.addEventListener('focus', () => {
      if (currentChartGeom && currentChartGeom.points.length && activePointIdx < 0) {
        updateCrosshair(currentChartGeom.points.length - 1, true);
      }
    });

    chartSvg.addEventListener('blur', () => {
      updateCrosshair(-1);
    });

    // Hydrate initial state from URL + fetch product JSON
    switchProduct(state.product);
  }
</script>
