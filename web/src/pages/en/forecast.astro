---
import ForecastPage from '../../components/ForecastPage.astro';
import { getDictionary, getLocalizedRoutes } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';

const locale = 'en';
const dict = getDictionary(locale);
const frRoutes = getLocalizedRoutes('fr', import.meta.env.BASE_URL);
---

<BaseLayout
  locale={locale}
  title={dict.meta.forecastTitle}
  description={dict.meta.forecastDescription}
  currentNav="forecast"
  switchLangHref={frRoutes.forecast}
>
  <ForecastPage locale={locale} />
</BaseLayout>
