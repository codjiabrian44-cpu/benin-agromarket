---
import MethodPage from '../components/MethodPage.astro';
import { getDictionary, getLocalizedRoutes } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';

const locale = 'fr';
const dict = getDictionary(locale);
const enRoutes = getLocalizedRoutes('en', import.meta.env.BASE_URL);
---

<BaseLayout
  locale={locale}
  title={dict.meta.methodTitle}
  description={dict.meta.methodDescription}
  currentNav="method"
  switchLangHref={enRoutes.method}
>
  <MethodPage locale={locale} />
</BaseLayout>
