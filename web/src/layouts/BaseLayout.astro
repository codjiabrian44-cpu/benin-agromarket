---
import { getDictionary, getLocalizedRoutes, type Locale } from '../i18n';
import { withBase } from '../lib/paths';
import '../styles/global.css';

export interface Props {
  locale: Locale;
  title: string;
  description: string;
  currentNav: 'home' | 'explorer' | 'forecast' | 'method' | '404';
  switchLangHref?: string;
}

const { locale, title, description, currentNav, switchLangHref } = Astro.props;
const dict = getDictionary(locale);
const baseUrl = import.meta.env.BASE_URL;
const routes = getLocalizedRoutes(locale, baseUrl);
const frRoutes = getLocalizedRoutes('fr', baseUrl);
const enRoutes = getLocalizedRoutes('en', baseUrl);
const targetSwitchHref = switchLangHref ?? routes.switchLang;

const siteOrigin = Astro.site ?? new URL('https://codjiabrian44-cpu.github.io');
const routeKey = currentNav === '404' ? 'notFound' : currentNav;
const currentPath = locale === 'fr' ? frRoutes[routeKey] : enRoutes[routeKey];
const canonicalUrl = new URL(currentPath, siteOrigin).toString();
const frAltUrl = new URL(frRoutes[routeKey], siteOrigin).toString();
const enAltUrl = new URL(enRoutes[routeKey], siteOrigin).toString();
const ogImageUrl = new URL(withBase('/og-image.png', baseUrl), siteOrigin).toString();

const frauncesUrl = withBase('/fonts/fraunces-latin-wght-normal.woff2', baseUrl);
const instrumentUrl = withBase('/fonts/instrument-sans-latin-wght-normal.woff2', baseUrl);
const faviconUrl = withBase('/favicon.svg', baseUrl);

const fontFaceCss = `
@font-face {
  font-family: 'Fraunces Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 100 900;
  src: url('${frauncesUrl}') format('woff2-variations');
  unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
@font-face {
  font-family: 'Instrument Sans Variable';
  font-style: normal;
  font-display: swap;
  font-weight: 400 700;
  src: url('${instrumentUrl}') format('woff2-variations');
  unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}
`;
---

<!doctype html>
<html lang={dict.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      currentNav !== '404' && (
        <>
          <link rel="canonical" href={canonicalUrl} />
          <link rel="alternate" hreflang="fr" href={frAltUrl} />
          <link rel="alternate" hreflang="en" href={enAltUrl} />
          <link rel="alternate" hreflang="x-default" href={frAltUrl} />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={dict.meta.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_BJ' : 'en_GB'} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/svg+xml" href={faviconUrl} />
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={instrumentUrl} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFaceCss}></style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">{dict.nav.skipToContent}</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href={routes.home} class="brand-link">
          <span class="brand-name">
            <span class="brand-triband" aria-hidden="true">
              <span class="swatch-maize"></span>
              <span class="swatch-tomato"></span>
              <span class="swatch-yam"></span>
            </span>
            {dict.meta.siteName}
          </span>
        </a>

        <nav aria-label={dict.nav.primaryNavAria} class="primary-nav">
          <ul class="nav-list">
            <li>
              <a
                href={routes.home}
                class="nav-link"
                aria-current={currentNav === 'home' ? 'page' : undefined}
              >
                {dict.nav.home}
              </a>
            </li>
            <li>
              <a
                href={routes.explorer}
                class="nav-link"
                aria-current={currentNav === 'explorer' ? 'page' : undefined}
              >
                {dict.nav.explorer}
              </a>
            </li>
            <li>
              <a
                href={routes.forecast}
                class="nav-link"
                aria-current={currentNav === 'forecast' ? 'page' : undefined}
              >
                {dict.nav.forecast}
              </a>
            </li>
            <li>
              <a
                href={routes.method}
                class="nav-link"
                aria-current={currentNav === 'method' ? 'page' : undefined}
              >
                {dict.nav.method}
              </a>
            </li>
          </ul>
        </nav>

        <a
          href={targetSwitchHref}
          class="lang-switch"
          aria-label={dict.nav.switchLangAria}
          lang={locale === 'fr' ? 'en' : 'fr'}
        >
          {dict.nav.switchLangLabel}
        </a>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <h2 class="footer-heading">{dict.footer.attributionHeading}</h2>
          <p class="footer-text">{dict.footer.wfpAttribution}</p>
          <p class="footer-text">{dict.footer.unofficialNotice}</p>
        </div>
        <div>
          <ul class="footer-meta-list">
            <li>
              <strong>{dict.footer.asOfLabel}</strong>{' '}
              <span class="tabular-nums">{dict.footer.asOfDateFormatted}</span>
            </li>
            <li>
              <a href={routes.method} class="footer-link">
                {dict.footer.modelCardLabel}
              </a>
            </li>
            <li>
              <a
                href="https://github.com/benin-agromarket/benin-agromarket"
                class="footer-link"
                rel="noopener noreferrer"
              >
                {dict.footer.githubLabel}
              </a>
            </li>
          </ul>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const mainEl = document.getElementById('main-content');
        if (!mainEl) return;
        document.addEventListener('click', function (e) {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const anchor = e.target && e.target.closest ? e.target.closest('a[href]') : null;
          if (!anchor || anchor.target || anchor.hasAttribute('download')) return;
          const href = anchor.getAttribute('href') || '';
          if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')) return;
          try {
            const url = new URL(href, window.location.href);
            if (url.origin !== window.location.origin) return;
            if (url.pathname === window.location.pathname && url.search === window.location.search) return;
            e.preventDefault();
            mainEl.classList.add('is-page-leaving');
            setTimeout(function () {
              window.location.href = url.href;
            }, 170);
          } catch (_) {}
        });
      })();
    </script>
  </body>
</html>
